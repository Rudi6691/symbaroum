<div class="{{cssClass}}{{#if renderModern}} modern-item-root{{/if}}">
{{!-- Item-Sheet-Modernisierung v1: Zweig-Umschalter am Wurzel-Template
    (Muster player.hbs/A6) - schaltet ein User sein Aktorblatt global um,
    gilt die moderne Ansicht auch hier; der klassische Zweig bleibt
    UNVERÄNDERT. --}}
{{#if renderModern}}
{{> systems/symbaroum/template/sheet/modern/item/equipment.hbs}}
{{else}}
    <div class="equipment">
        <div class="sheet-header foreground border">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" data-tooltip="{{item.name}}"/>
            </div>
            <div class="wrapper-column">
                <div class="name">
                    <label for="{{id}}-name">{{localize "EQUIPMENT.NAME"}}</label>
                    <input name="name" id="{{id}}-name" type="text" value="{{item.name}}"/>
                </div>
            </div>
        </div>
        <div class="sheet-tabs tabs" data-group="primary">
            <b class="item" data-tab="description">{{localize "TAB.DESCRIPTION"}}</b>
            {{#if system.isArtifact}}
            <b class="item" data-tab="power">{{localize "TAB.POWER"}}</b>
            {{/if}}
            <b class="item" data-tab="bonus">{{localize "TAB.BONUS"}}</b>
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="description">
                <div class="description foreground border">
                    <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                    <div class="cost">
                        <label>{{localize "EQUIPMENT.COST"}}</label>
                        {{!-- Teil 3 (Preisbasis): Basispreis als Ganzzahl in Orteg, editiert im
                            Geld-Element (wie beim Aktorblatt); nur bei migrierten Items
                            (system.price = Integer). Altformat {value, denomination} oder
                            fehlendes Feld => Migrationshinweis, Konvertierung nur per
                            GM-Makro "Preisbasis-Migration". --}}
                        {{#if (priceExists item)}}
                        <symbaroum-currency value="{{item.system.price}}"{{#unless editable}} readonly{{/unless}}></symbaroum-currency>
                        {{else}}
                        <span class="price-migration-hint">{{localize "PRICE.MIGRATION_HINT"}}</span>
                        {{/if}}
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.number">{{localize "EQUIPMENT.NUMBER"}}</label>
                        <input id="{{id}}-system.number" name="system.number" type="number" value="{{system.number}}"/>
                    </div>
                    <div class="weight">
                        <label for="{{id}}-system.weight">{{localize "WEIGHT.LABEL"}}</label>
                        {{!-- A39 (Runde-1-Wunsch): Gewicht-Zeile IMMER anzeigen und
                            direkt wählbar - auch bei deaktivierten Belastungsregeln
                            (Rudolfs Testrunde 1). Alt-Items ohne Gewichtsangabe
                            starten auf "Keine Angabe" (Nullwert); die Auswahl wird
                            erst beim Speichern geschrieben. --}}
                        <select id="{{id}}-system.weight" name="system.weight" data-tooltip="{{localize "WEIGHT.TOOLTIP"}}">{{{weightOptions item}}}</select>
                    </div>
                    {{!-- Ressourcen v1, Testrunde 1 (Rudolfs Zusatzwunsch zu
                        Punkt 3): Artefakt- und Stapelbar-Checkbox sind
                        SL-Sache (Item-Taxonomie wie die Ressourcen-Kategorie)
                        - für Spieler ausgeblendet, der WERT bleibt erhalten. --}}
                    {{#if symbaroumOptions.isGM}}
                    <div class="number">
                        <label for="{{id}}-system.isArtifact">{{localize "ITEM.ARTIFACT"}}</label>
                        {{#if system.isArtifact}}
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact" checked/>
                        {{else}}
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact"/>
                        {{/if}}
                    </div>
                    {{!-- AP2 v2 (Uniform-Regel): Die Stapelbar-Zeile ist jetzt IMMER
                        sichtbar (nicht mehr nur bei Artefakt-Ausrüstung). Ausrüstung
                        ohne Artefakt-Flag ist default stapelbar (Merge-on-Drop bleibt
                        an - Rationen etc.); abwählen = expliziter Opt-out. Artefakt-
                        Ausrüstung bleibt default NICHT stapelbar, anwählen = Opt-in.
                        stackableChecked (item.js) zeigt den EFFEKTIVEN Zustand, damit
                        der erste Form-Submit undefined nicht fälschlich als false
                        festnagelt. --}}
                    <div class="stackable">
                        <label for="{{id}}-system.stackable">{{localize "STACK.LABEL"}}</label>
                        {{#if stackableChecked}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" checked data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{else}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{/if}}
                    </div>
                    {{/if}}
                    {{!-- Ressourcen v1: Ressourcen-Kategorie (GM-only) - additives
                        Feld system.resourceCategory statt Flags; steuert den
                        kategoriebasierten Verbrauch (Medicus bucht Kraeuterarznei
                        beim Wurf ab, Kontextmenü „Ressource verbrauchen" am
                        Inventar-Item). Leere Auswahl = keine Ressource. --}}
                    {{#if showResourceCategory}}
                    <div class="resourcecategory">
                        <label for="{{id}}-system.resourceCategory" data-tooltip="{{localize "RESOURCE_CATEGORY.TOOLTIP"}}">{{localize "RESOURCE_CATEGORY.LABEL"}}</label>
                        <select id="{{id}}-system.resourceCategory" name="system.resourceCategory" data-tooltip="{{localize "RESOURCE_CATEGORY.TOOLTIP"}}">
                            {{selectOptions resource_category_selection selected=resourceCategory valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{/if}}
                    <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
                </div>
            </div>
            <div class="tab" data-group="primary" data-tab="bonus">
                {{> systems/symbaroum/template/sheet/tab/bonus.hbs}}
            </div>
            {{#if system.isArtifact}}
            <div class="tab" data-group="primary" data-tab="power">
                {{> systems/symbaroum/template/sheet/tab/artifact.hbs}}
            </div>
            {{/if}}
        </div>
    </div>
{{/if}}
</div>
