<div class="{{cssClass}}">
    <div class="equipment">
        <div class="sheet-header foreground border">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" data-tooltip="{{item.name}}"/>
            </div>
            <div class="wrapper-column">
                <div class="name">
                    <label for="{{id}}-name">{{localize "EQUIPMENT.NAME"}}</label>
                    <input name="name" id="{{id}}-name" type="text" value="{{item.name}}"/>
                </div>
            </div>
        </div>
        <div class="sheet-tabs tabs" data-group="primary">
            <b class="item" data-tab="description">{{localize "TAB.DESCRIPTION"}}</b>
            {{#if system.isArtifact}}
            <b class="item" data-tab="power">{{localize "TAB.POWER"}}</b>
            {{/if}}
            <b class="item" data-tab="bonus">{{localize "TAB.BONUS"}}</b>
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="description">
                <div class="description foreground border">
                    <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                    <div class="cost">
                        <label>{{localize "EQUIPMENT.COST"}}</label>
                        {{!-- A38: Preisfeld nur bei migrierten Items (system.price vorhanden),
                            sonst Migrationshinweis - schützt Alt-Items vor stillschweigender
                            Vor-Migration beim Abspeichern. --}}
                        {{#if (priceExists item)}}
                        <input type="number" min="0" step="1" data-dtype="Number" name="system.price.value" id="{{id}}-system.price.value" value="{{item.system.price.value}}"/>
                        <select name="system.price.denomination" id="{{id}}-system.price.denomination">{{{priceDenominations item}}}</select>
                        {{else}}
                        <span class="price-migration-hint">{{localize "PRICE.MIGRATION_HINT"}}</span>
                        {{/if}}
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.number">{{localize "EQUIPMENT.NUMBER"}}</label>
                        <input id="{{id}}-system.number" name="system.number" type="number" value="{{system.number}}"/>
                    </div>
                    <div class="weight">
                        <label for="{{id}}-system.weight">{{localize "WEIGHT.LABEL"}}</label>
                        {{!-- A39: Gewichtskategorie nur bei Items mit Feld (Neuanlage hat es ab
                            Geburt), sonst Migrationshinweis - schützt Alt-Items vor stillschweigender
                            Vor-Migration beim Abspeichern (gleiches Muster wie der A38-Preis). --}}
                        {{#if (weightExists item)}}
                        <select id="{{id}}-system.weight" name="system.weight" data-tooltip="{{localize "WEIGHT.TOOLTIP"}}">{{{weightOptions item}}}</select>
                        {{else}}
                        <span class="price-migration-hint">{{localize "WEIGHT.MIGRATION_HINT"}}</span>
                        {{/if}}
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.isArtifact">{{localize "ITEM.ARTIFACT"}}</label>
                        {{#if system.isArtifact}}
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact" checked/>
                        {{else}}
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact"/>
                        {{/if}}
                    </div>
                    <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
                </div>
            </div>
            <div class="tab" data-group="primary" data-tab="bonus">
                {{> systems/symbaroum/template/sheet/tab/bonus.hbs}}
            </div>
            {{#if system.isArtifact}}
            <div class="tab" data-group="primary" data-tab="power">
                {{> systems/symbaroum/template/sheet/tab/artifact.hbs}}
            </div>
            {{/if}}
        </div>
    </div>
</div>