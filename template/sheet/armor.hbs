<div class="{{cssClass}}{{#if renderModern}} modern-item-root{{/if}}">
{{!-- Item-Sheet-Modernisierung v1: Zweig-Umschalter am Wurzel-Template
    (Muster player.hbs/A6) - schaltet ein User sein Aktorblatt global um,
    gilt die moderne Ansicht auch hier; der klassische Zweig bleibt
    UNVERÄNDERT. --}}
{{#if renderModern}}
{{> systems/symbaroum/template/sheet/modern/item/armor.hbs}}
{{else}}
    <div class="armor">
        <div class="sheet-header foreground border">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" data-tooltip="{{item.name}}"/>
            </div>
            <div class="wrapper-column">
                <div class="name">
                    <label for="{{id}}-name">{{localize "ARMOR.NAME"}}</label>
                    <input id="{{id}}-name" name="name" type="text" value="{{item.name}}"/>
                </div>
                <div class="computedvalues">
                    <div class="wrapper-column">
                        <label>{{localize "ARMOR.PC_PROTECTION"}}</label>
                        <input type="text" value="{{system.pcProtection}}" data-dtype="Text" disabled/>
                    </div>
                    <div class="wrapper-column">
                        <label>{{localize "ARMOR.NPC_PROTECTION"}}</label>
                        <input type="number" value="{{system.npcProtection}}" data-dtype="Number" disabled/>
                    </div>
                </div>
            </div>
        </div>

        <div class="sheet-tabs tabs" data-group="primary">
            <b class="item" data-tab="description">{{localize "TAB.DESCRIPTION"}}</b>
            <b class="item" data-tab="stats">{{localize "TAB.STATS"}}</b>
            <b class="item" data-tab="qualities">{{localize "TAB.QUALITIES"}}</b>
            {{#if system.isArtifact}}
            <b class="item" data-tab="power">{{localize "TAB.POWER"}}</b>
            {{/if}}
            <b class="item" data-tab="bonus">{{localize "TAB.BONUS"}}</b>
        </div>
        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="description">
                <div class="description foreground border">
                    <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                    <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
                </div>
            </div>
            <div class="tab" data-group="primary" data-tab="stats">
                <div class="stats foreground border">
                    <h1>{{localize "TITLE.STATS"}}</h1>
                    <div class="protection">
                        <label for="{{id}}-system.baseProtection">{{localize "ARMOR.BASE_PROT"}}</label>
                        <select for="{{id}}-system.baseProtection" name="system.baseProtection">
                            {{selectOptions protection_selection selected=system.baseProtection labelAttr="label"}}
                        </select>
                    </div>
                    <div class="protection">
                        <label for="{{id}}-system.bonusProtection">{{localize "ARMOR.BONUS_PROT"}}</label>
                        <input id="{{id}}-system.bonusProtection" name="system.bonusProtection" type="text" value="{{system.bonusProtection}}"/>
                    </div>
                    <div class="cost">
                        <label>{{localize "ARMOR.COST"}}</label>
                        {{!-- Teil 3 (Preisbasis): Basispreis als Ganzzahl in Orteg, editiert im
                            Geld-Element (wie beim Aktorblatt); nur bei migrierten Items
                            (system.price = Integer). Altformat {value, denomination} oder
                            fehlendes Feld => Migrationshinweis, Konvertierung nur per
                            GM-Makro "Preisbasis-Migration". --}}
                        {{#if (priceExists item)}}
                        <symbaroum-currency value="{{item.system.price}}"{{#unless editable}} readonly{{/unless}}></symbaroum-currency>
                        {{else}}
                        <span class="price-migration-hint">{{localize "PRICE.MIGRATION_HINT"}}</span>
                        {{/if}}
                    </div>
                    {{!-- Ressourcen v1, Testrunde 1 (Rudolfs Zusatzwunsch zu
                        Punkt 3): Artefakt- und Stapelbar-Checkbox sind
                        SL-Sache (Item-Taxonomie wie die Ressourcen-Kategorie)
                        - für Spieler ausgeblendet, der WERT bleibt erhalten. --}}
                    {{#if isGM}}
                    <div class="number">
                        <label for="{{id}}-system.isArtifact">{{localize "ITEM.ARTIFACT"}}</label>
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact" {{checked system.isArtifact}}/>
                    </div>
                    {{/if}}
                    {{!-- AP2 v2 (Uniform-Regel): Anzahl-Verwaltung wie am Artefakt-Blatt
                        (Rüstungen hatten bisher keine Anzahl-Zeile) mit Anzeige-Fallback 1;
                        Waffen besitzen die Zeile bereits. --}}
                    <div class="number">
                        <label for="{{id}}-system.number">{{localize "EQUIPMENT.NUMBER"}}</label>
                        <input id="{{id}}-system.number" name="system.number" type="number" value="{{#if system.number}}{{system.number}}{{else}}1{{/if}}" data-tooltip="{{localize "STACK.NUMBER_TOOLTIP"}}"/>
                    </div>
                    {{#if isGM}}
                    <div class="stackable">
                        <label for="{{id}}-system.stackable">{{localize "STACK.LABEL"}}</label>
                        {{!-- AP2 v2 (Uniform-Regel): Rüstungen sind default NICHT stapelbar -
                            hier wird pro Item explizit opt-in (oder opt-out) entschieden.
                            stackableChecked (item.js) zeigt den EFFEKTIVEN Zustand. --}}
                        {{#if stackableChecked}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" checked data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{else}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{/if}}
                    </div>
                    {{/if}}
                    <div class="weight">
                        <label for="{{id}}-system.weight">{{localize "WEIGHT.LABEL"}}</label>
                        {{!-- A39 (Runde-1-Wunsch): Gewicht-Zeile IMMER anzeigen und
                            direkt wählbar - auch bei deaktivierten Belastungsregeln
                            (Rudolfs Testrunde 1). Alt-Items ohne Gewichtsangabe
                            starten auf "Keine Angabe" (Nullwert); die Auswahl wird
                            erst beim Speichern geschrieben.
                            Mitgeführte Rüstung zählt entsprechend ihrer Behinderung, getragene
                            (aktive) Rüstung zählt nicht. --}}
                        <select id="{{id}}-system.weight" name="system.weight" data-tooltip="{{localize "WEIGHT.TOOLTIP_ARMOR"}}">{{{weightOptions item}}}</select>
                    </div>
                    <div class="quality">
                        <label for="{{id}}-system.quality">{{localize "ARMOR.QUALITY"}}</label>
                        <input id="{{id}}-system.quality" name="system.quality" type="text" value="{{system.quality}}"/>
                    </div>
                </div>
            </div>
            <div class="tab" data-group="primary" data-tab="qualities">
                <div class="qualities foreground border">
                    <h1>{{localize "TITLE.QUALITIES"}}</h1>
                    {{#each qualities as | quality |}}
                    <div class="{{#if_even @index}}rightcolumn{{else}}leftcolumn{{/if_even}}">
                        <label for="{{id}}-system.qualities.{{quality}}">{{qualitylocalize quality}}</label>
                        <input id="{{id}}-system.qualities.{{quality}}" name="system.qualities.{{quality}}" type="checkbox" value="flexible" {{checked (lookup ../system.qualities quality)}}/>
                    </div>
                    {{/each}}
                </div>
                {{#if_nempty compatibilities}}
                <div class="qualities foreground border">
                    <h1>{{localize "TITLE.SPECIALQUALITIES"}}</h1>
                    {{#each compatibilities as | compatibility |}}
                    <div class="{{#if_even @index}}rightcolumn{{else}}leftcolumn{{/if_even}}">
                        <label for="{{id}}-system.qualities.{{compatibility}}">{{qualitylocalize compatibility}}</label>
                        <input id="{{id}}-system.qualities.{{compatibility}}" name="system.qualities.{{compatibility}}" type="checkbox" value="flexible" {{checked (lookup ../system.qualities compatibility)}}/>
                    </div>
                    {{/each}}
                </div>
                {{/if_nempty}}                
            </div>
            <div class="tab" data-group="primary" data-tab="bonus">
                {{> systems/symbaroum/template/sheet/tab/bonus.hbs}}
            </div>
            {{#if system.isArtifact}}
            <div class="tab" data-group="primary" data-tab="power">
                {{> systems/symbaroum/template/sheet/tab/artifact.hbs}}
            </div>
            {{/if}}
        </div>
    </div>
{{/if}}
</div>
