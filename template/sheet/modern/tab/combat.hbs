{{!-- A6: Kampf-Tab - möglichst alle Werte, die im Kampf gebraucht werden.
    Chips: Verteidigung, Rüstungsschutz, Behinderung, Initiative, Erfahrung
    (Klick = Erfahrungs-Dialog). Darunter aktive Rüstung (immer) und aktive
    Waffen (immer), dann Favoriten (Fähigkeiten/Kräfte ausschließlich per
    Favorit, andere Ausrüstung nur per Favorit; Stern pro Charakter/Item-Flag). --}}
<div class="m-combat">
    <div class="m-chips">
        <div class="m-chip" data-tooltip="{{{modern.combat.defenseTooltip}}}">
            <div class="v">{{modern.combat.defenseDisplay}}</div>
            <div class="l">{{localize "MODERN.CHIP_DEFENSE"}}</div>
        </div>
        <div class="m-chip" data-tooltip="{{system.combat.tooltipProt}}">
            <div class="v">{{system.combat.displayTextShort}}</div>
            <div class="l">{{localize "MODERN.CHIP_PROTECTION"}}</div>
        </div>
        <div class="m-chip" data-tooltip="{{localize "ARMOR.IMPEDING"}} ({{localize system.combat.defenseAttribute.label}})">
            <div class="v">{{modern.combat.impedingDisplay}}</div>
            <div class="l">{{localize "MODERN.CHIP_IMPEDING"}}</div>
        </div>
        {{!-- A6v4 (Testrunde 3): Initiative-Tooltip - das tatsächlich
            verwendete Attribut statt des kaputten Literal-Platzhalters
            (in JS vorberechnet: "Initiative angezeigt als Aufmerksamkeit"). --}}
        <div class="m-chip" data-tooltip="{{modern.combat.initiativeTooltip}}">
            <div class="v">{{toFixed system.initiative.value 2}}</div>
            <div class="l">{{localize "INITIATIVE.TITLE"}}</div>
        </div>
        {{!-- Testrunde-2-Fund: Defaultanzeige = Gesamt-XP (Details im Hover
            und im Dialog); verfügbar bleibt dort sichtbar. --}}
        <button type="button" class="m-chip m-chip-click modern-exp" data-tooltip="{{{modern.exp.tooltip}}}">
            <div class="v">{{modern.exp.total}}</div>
            <div class="l">{{localize "MODERN.CHIP_EXPERIENCE"}}</div>
        </button>
    </div>

    <div class="m-box">
        <div class="m-box-h">
            <span>{{localize "MODERN.ACTIVE_ARMOR"}}</span>
            {{!-- A6v9 (Testrunde 8, Rudolfs Wunsch): klärende Hinweise hinter
                den Überschriften (erscheint immer / Favorit-Regel) entfernt. --}}
        </div>
        <div class="m-box-b">
            {{!-- A6v4 (Testrunde 3): die lookup/with-Subexpression im v3-Template
                renderte in Foundry V14 nichts - die Zeilen kommen fertig aus dem
                JS-Kontext (modern.combat.armor); das Status-Chip ist klickbar wie im
                Ausrüstungs-Tab (Zustands-Zyklus + Belastungswirkung), bei
                "keine Rüstung" statisch. --}}
            <div class="symbaroum-contextmenu item m-inv-row draggable" data-item-id="{{modern.combat.armor.id}}">
                <div class="m-item-img" style="background-image: url('{{modern.combat.armor.img}}');"></div>
                <button type="button" class="roll-armor m-inv-name">{{modern.combat.armor.name}}<small>{{modern.combat.armor.sub}}</small></button>
                {{#if modern.combat.armor.chip}}
                <button type="button" class="item-state m-st m-st-{{modern.combat.armor.chip.state}}" data-tooltip="{{modern.combat.armor.chip.tooltip}}"><i class="{{modern.combat.armor.chip.icon}}"></i></button>
                {{else}}
                <span class="m-st m-st-active">{{localize "GEAR.ACTIVE"}}</span>
                {{/if}}
            </div>
        </div>
    </div>

    <div class="m-box">
        <div class="m-box-h">
            <span>{{localize "MODERN.ACTIVE_WEAPONS"}}</span>
        </div>
        <div class="m-box-b">
            {{!-- A6v4 (Testrunde 3): aktive Waffen als fertige Zeilen aus dem
                JS-Kontext (modern.combat.weapons) - inklusive klickbarem
                Status-Chip (in JS vorberechnet, kein lookup/with). --}}
            {{#each modern.combat.weapons as |item|}}
            <div class="symbaroum-contextmenu item m-inv-row draggable" data-item-id="{{item.id}}">
                <div class="m-item-img" style="background-image: url('{{item.img}}');"></div>
                <button type="button" class="roll-weapon m-inv-name">{{item.name}}<small>{{item.damageShort}}</small></button>
                <span class="m-attr-abbr" data-tooltip="{{item.attrTooltip}}">{{item.attrAbbr}}</span>
                {{#if item.chip}}
                <button type="button" class="item-state m-st m-st-{{item.chip.state}}" data-tooltip="{{item.chip.tooltip}}"><i class="{{item.chip.icon}}"></i></button>
                {{/if}}
            </div>
            {{/each}}
        </div>
    </div>

    <div class="m-box">
        <div class="m-box-h">
            <span>{{localize "MODERN.FAVORITES"}}</span>
        </div>
        <div class="m-box-b">
            {{#if modern.hasFavorites}}
            <div class="m-tiles">
                {{#each modern.favorites as |fav|}}
                <div class="symbaroum-contextmenu item m-tile draggable" data-item-id="{{fav.id}}">
                    <div class="m-tile-head">
                        {{#ife fav.kind 'power'}}
                        <div class="m-tile-imgwrap">
                            <button type="button" class="activate-ability {{#if fav.hasScript}}isScripted{{else}}notScripted{{/if}} m-tile-img" style="background-image: url('{{fav.img}}');" data-tooltip="{{localize "TOOLTIP.USE_ABILITY"}}"></button>
                            {{#if fav.hasScript}}<span class="automatic" data-tooltip="{{localize "TOOLTIP.DIALOG.HASSCRIPT"}}"></span>{{/if}}
                        </div>
                        {{/ife}}
                        {{#ife fav.kind 'weapon'}}
                        <button type="button" class="roll-weapon m-tile-img" style="background-image: url('{{fav.img}}');" data-tooltip="{{localize "TOOLTIP.USE_WEAPON"}}"></button>
                        {{/ife}}
                        {{#ife fav.kind 'armor'}}
                        <button type="button" class="roll-armor m-tile-img" style="background-image: url('{{fav.img}}');" data-tooltip="{{localize "TOOLTIP.USE_ARMOR"}}"></button>
                        {{/ife}}
                        {{#ife fav.kind 'gear'}}
                        <button type="button" class="item-edit m-tile-img" style="background-image: url('{{fav.img}}');" data-tooltip="{{localize "TOOLTIP.VIEW_ITEM"}}"></button>
                        {{/ife}}
                        <button type="button" class="item-edit m-tile-name">{{fav.name}}<small>{{fav.sub}}</small></button>
                        <button type="button" class="favorite-toggle active" data-tooltip="{{localize "MODERN.FAVORITE_TOGGLE"}}"><svg class="m-star" viewBox="0 0 576 512" aria-hidden="true"><path d="M288 24L342.8 192.6L520.1 192.6L376.6 296.8L431.4 465.4L288 361.2L144.6 465.4L199.4 296.8L55.9 192.6L233.2 192.6Z"/></svg></button>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <p class="m-hint">{{localize "MODERN.FAVORITES_EMPTY"}}</p>
            {{/if}}
        </div>
    </div>
</div>
