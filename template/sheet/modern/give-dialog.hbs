{{!-- Übergabe v1 (spielimmersive Aktionen): Dialog für Item- und Geld-
    Übergabe. Rudolfs Entscheidungen (31.10.): Quelle fix = offenes Blatt
    ("Von: <Name>"), Empfänger über EIN gegliedertes select (optgroup
    "Anwesende" der aktiven Szene, danach die Charaktere der Spieler als
    Fallback für token-loses Erzählen - ersetzt den besprochenen Zwei-
    Stufen-Wizard, weil Rudolfs Kernziel weniger Klicks sind), stapelbare
    Items Default 1 (Stepper-Feld, max = Anzahl), Behälter ohne Stepper
    mit Inhalts-Zusammenfassung, Geld über das <symbaroum-currency>-Element
    (A38-Delta-Syntax wie im Währungsdialog), Radios Öffentlich (Default)
    / Flüstern. Muster: attributes-dialog.hbs / split-dialog.hbs
    (renderTemplate mit vollem Pfad, kein Partial). --}}
<div class="symbaroum modern-give-dialog">
    <div class="m-give-from" data-tooltip="{{localize 'GIVE.FROM'}}">{{localize "GIVE.FROM"}}: <b>{{sourceName}}</b></div>

    {{#if item}}
    <div class="m-give-item">
        {{#if item.img}}<img class="m-give-img" src="{{item.img}}" alt=""/>{{/if}}
        <span class="m-give-name">{{item.name}}</span>
    </div>
    {{/if}}

    <label class="m-sec-label" for="give-target">{{localize "GIVE.RECIPIENT"}}</label>
    <select id="give-target" class="m-give-target">
        {{#if recipients.tokens.length}}
        <optgroup label="{{localize 'GIVE.GROUP_SCENE'}}">
            {{#each recipients.tokens as |r|}}
            <option value="{{r.value}}">{{r.name}}</option>
            {{/each}}
        </optgroup>
        {{/if}}
        {{#each recipients.groups as |g|}}
        <optgroup label="{{g.label}}">
            {{#each g.actors as |a|}}
            <option value="{{a.value}}">{{a.name}}</option>
            {{/each}}
        </optgroup>
        {{/each}}
    </select>

    {{#if item}}
    {{#if item.isContainer}}
    <div class="m-give-note">
        <i class="fas fa-box-archive"></i>
        <span>{{localize "GIVE.CONTAINER_NOTE"}}</span>
        <span class="m-give-summary">{{item.summary}}</span>
    </div>
    {{else if item.stackable}}
    <label class="m-sec-label" for="give-quantity">{{localize "GIVE.QUANTITY"}}</label>
    <input id="give-quantity" class="m-give-quantity" type="number" min="1" max="{{item.max}}" value="1" data-tooltip="{{localize 'GIVE.QUANTITY_TOOLTIP'}}"/>
    {{/if}}
    {{/if}}

    {{#if money}}
    <div class="m-give-currency">
        <symbaroum-currency value="0"></symbaroum-currency>
    </div>
    <div class="m-give-note m-give-moneyhint">
        <i class="fas fa-coins"></i>
        <span>{{money.hint}}</span>
    </div>
    {{/if}}

    {{!-- Übergabe v1.6 (Rudolfs Layout-Wunsch aus Testrunde 4, Freigabe
         31.10.): Aufbau analog Dreckiger Kampf im Würfeldialog - Rahmen
         mit Überschrift (fieldset + legend), darin Rahmen mit den Radios;
         Radio-Darstellung identisch zu den Würfeldialog-Radios (lblfavour-
         Optik, keine Box-Rahmen mehr). JS liest unverändert
         input[name="give-vis"]:checked (transfer.js). --}}
    <fieldset class="m-ability-frame">
        <legend class="m-ability-label">{{localize "GIVE.VISIBILITY"}}</legend>
        <div class="m-give-vis">
            <label class="lblfavour">
                <input type="radio" name="give-vis" value="public" checked/>
                {{localize "GIVE.VISIBILITY_PUBLIC"}}
            </label>
            <label class="lblfavour">
                <input type="radio" name="give-vis" value="whisper"/>
                {{localize "GIVE.VISIBILITY_WHISPER"}}
            </label>
        </div>
    </fieldset>
</div>
