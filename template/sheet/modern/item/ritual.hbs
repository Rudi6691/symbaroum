{{!-- Item-Sheet-Modernisierung v1: Ritual-Blatt, modernisierte Ansicht.
    Kopf ohne Preis/Gewicht/Anzahl; Beschreibungs-tab (Traditionen v1 ohne
    Freitext-Feld — Zuordnung im „Traditionen“-Tab), sonst Beschreibung +
    Bonus. --}}
{{> systems/symbaroum/template/sheet/modern/item/header.hbs}}
    <div class="sheet-body m-item-body">
        <div class="tab" data-group="primary" data-tab="description">
            <div class="m-panel">
                {{!-- Segen & Lasten S2 Baustein A (Rudolfs „Leg los“, 06.11.2026):
                    Augur-Hinweis-Chip am Ritual-Blatt, moderne Ansicht —
                    gleiche Bedingung/Text wie das klassische Blatt
                    (context.augurChip, item.js). --}}
                {{#if augurChip}}
                <div class="m-roll-note augur-chip-row">{{augurChip}}</div>
                {{/if}}
                {{!-- Traditionen v1: zugeordnete Traditionen read-only (rendert nur bei vorhandenen Labels). --}}
                {{> systems/symbaroum/template/sheet/tab/traditions-display.hbs}}
                <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                {{!-- Traditionen v1: Freitext „Tradition“ ENTFERNT - die
                    Zuordnung läuft über system.traditions + Gate im
                    „Traditionen“-Tab (GM); der Altbestand bleibt als
                    Datenfeld für das Migrations-Makro erhalten. Anzeige
                    über traditions-display.hbs oben. --}}
                <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
            </div>
        </div>
        {{!-- v1.3: Bonus-Tab GM-only (Rudolfs Nachtest v1.2): Rail-Button UND Inhalt. --}}
        {{#if symbaroumOptions.isGM}}
        <div class="tab" data-group="primary" data-tab="bonus">
            {{> systems/symbaroum/template/sheet/modern/item/tab-bonus.hbs}}
        </div>
        {{/if}}
        {{!-- Traditionen v1: GM-only „Traditionen“-Tab, modern. --}}
        {{#if symbaroumOptions.isGM}}
        <div class="tab" data-group="primary" data-tab="traditions">
            {{> systems/symbaroum/template/sheet/modern/item/tab-traditions.hbs}}
        </div>
        {{/if}}
    </div>
</div>
    <nav class="modern-rail tabs sheet-tabs" data-group="primary" data-tooltip-direction="LEFT">
        <button type="button" class="modern-rail-btn" data-tab="description" data-tooltip="{{localize 'TAB.DESCRIPTION'}}"><i class="fas fa-feather-pointed"></i></button>
        {{#if symbaroumOptions.isGM}}<button type="button" class="modern-rail-btn" data-tab="bonus" data-tooltip="{{localize 'TAB.BONUS'}}"><i class="fas fa-gears"></i></button>{{/if}}
        {{!-- Traditionen v1: Rail-Button „Traditionen“ GM-only (alle Blätter). --}}
        {{#if symbaroumOptions.isGM}}<button type="button" class="modern-rail-btn" data-tab="traditions" data-tooltip="{{localize 'TRADITION.TAB_LABEL'}}"><i class="fas fa-gear"></i></button>{{/if}}
    </nav>
</div>
