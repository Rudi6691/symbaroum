{{!-- Item-Sheet-Modernisierung v1: Ausrüstungs-Blatt, modernisierte Ansicht.
    Fixer Kopf mit Preis-Chip (Klick -> Währungsdialog), Gewicht und Anzahl
    (±-Pfeile nur bei stapelbaren Items). Beschreibung = erster Tab mit den
    beiden Checkbox-Feldern Artefakt/Stapelbar; Kraft-Tab nur bei isArtifact
    (gemeinsames Partial, wie klassisch); Bonus-Tab. --}}
{{> systems/symbaroum/template/sheet/modern/item/header.hbs}}
    <div class="sheet-body m-item-body">
        <div class="tab" data-group="primary" data-tab="description">
            {{!-- Elixier-Automatisierung v1.2 (Rudolfs Testfund: Beschrei-
                bungs-Tab scrollt nicht mit den GM-Feldern): Das Fill-Layout
                des Beschreibungs-Tabs gibt nur dem Editor einen Scroll-
                Container - die GM-Feldzeilen darüber werden bei Platz-
                mangel abgeschnitten. Mit Elixier-Feldern (GM + equipment)
                scrollt das PANEL als Ganzes (EIN Scrollbalken). Strukturell
                geloest wird das erst durch den geplanten Status-Tab, der
                die GM-Felder aus dem Beschreibungs-Tab herauszieht. --}}
            <div class="m-panel{{#if showElixirFields}} m-panel-ovY{{/if}}">
                <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                <div class="m-row">
                    {{!-- Ressourcen v1, Testrunde 1 (Rudolfs Zusatzwunsch zu
                        Punkt 3): Artefakt- und Stapelbar-Checkbox sind
                        SL-Sache (Item-Taxonomie wie die Ressourcen-Kategorie)
                        - für Spieler ausgeblendet, der WERT bleibt erhalten. --}}
                    {{#if symbaroumOptions.isGM}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.isArtifact">{{localize "ITEM.ARTIFACT"}}</label>
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact" {{checked system.isArtifact}}/>
                    </div>
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.stackable">{{localize "STACK.LABEL"}}</label>
                        {{#if stackableChecked}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" checked data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{else}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{/if}}
                    </div>
                    {{/if}}
                    {{!-- Ressourcen v1: Ressourcen-Kategorie (GM-only) - additives
                        Feld system.resourceCategory statt Flags; steuert den
                        kategoriebasierten Verbrauch (Medicus bucht Kraeuterarznei
                        beim Wurf ab, Kontextmenü „Ressource verbrauchen" am
                        Inventar-Item). Leere Auswahl = keine Ressource. --}}
                    {{#if showResourceCategory}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.resourceCategory" data-tooltip="{{localize "RESOURCE_CATEGORY.TOOLTIP"}}">{{localize "RESOURCE_CATEGORY.LABEL"}}</label>
                        <select id="{{id}}-system.resourceCategory" name="system.resourceCategory" data-tooltip="{{localize "RESOURCE_CATEGORY.TOOLTIP"}}">
                            {{selectOptions resource_category_selection selected=resourceCategory valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{/if}}
                    {{!-- Elixier-Automatisierung v1: Elixier-Steuerung (GM-only,
                        moderne Inline-Zeilen) - Alchemie-Stufe + Verwendungsform,
                        Munitionswirkung nur auf Munitions-Items; Wirkungsfelder
                        im gemeinsamen Partial (eigener CSS-Block). --}}
                    {{#if showElixirFields}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.alchemyLevel" data-tooltip="{{localize "ALCHEMY_LEVEL.TOOLTIP"}}">{{localize "ALCHEMY_LEVEL.LABEL"}}</label>
                        <select id="{{id}}-system.alchemyLevel" name="system.alchemyLevel" data-tooltip="{{localize "ALCHEMY_LEVEL.TOOLTIP"}}">
                            {{selectOptions alchemy_level_selection selected=alchemyLevel valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.elixirUsage" data-tooltip="{{localize "ELIXIR.USAGE_TOOLTIP"}}">{{localize "ELIXIR.USAGE_LABEL"}}</label>
                        <select id="{{id}}-system.elixirUsage" name="system.elixirUsage" data-tooltip="{{localize "ELIXIR.USAGE_TOOLTIP"}}">
                            {{selectOptions elixir_usage_selection selected=elixirUsage valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{#if showAmmoEffect}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.ammoEffect" data-tooltip="{{localize "AMMO_EFFECT.TOOLTIP"}}">{{localize "AMMO_EFFECT.LABEL"}}</label>
                        <select id="{{id}}-system.ammoEffect" name="system.ammoEffect" data-tooltip="{{localize "AMMO_EFFECT.TOOLTIP"}}">
                            {{selectOptions ammo_effect_selection selected=ammoEffect valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{/if}}
                    {{/if}}
                </div>
                {{#if showElixirFields}}
                {{> systems/symbaroum/template/sheet/tab/elixir-effect.hbs}}
                {{/if}}
                <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
            </div>
        </div>
        {{#if system.isArtifact}}
        {{> systems/symbaroum/template/sheet/tab/artifact.hbs}}
        {{/if}}
        <div class="tab" data-group="primary" data-tab="bonus">
            {{> systems/symbaroum/template/sheet/modern/item/tab-bonus.hbs}}
        </div>
    </div>
</div>
    <nav class="modern-rail tabs sheet-tabs" data-group="primary" data-tooltip-direction="LEFT">
        <button type="button" class="modern-rail-btn" data-tab="description" data-tooltip="{{localize 'TAB.DESCRIPTION'}}"><i class="fas fa-feather-pointed"></i></button>
        {{#if system.isArtifact}}
        <button type="button" class="modern-rail-btn" data-tab="power" data-tooltip="{{localize 'TAB.POWER'}}"><i class="fas fa-wand-magic-sparkles"></i></button>
        {{/if}}
        <button type="button" class="modern-rail-btn" data-tab="bonus" data-tooltip="{{localize 'TAB.BONUS'}}"><i class="fas fa-gears"></i></button>
    </nav>
</div>
