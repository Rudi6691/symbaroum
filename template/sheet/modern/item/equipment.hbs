{{!-- Item-Sheet-Modernisierung v1: Ausrüstungs-Blatt, modernisierte Ansicht.
    Fixer Kopf mit Preis-Chip (Klick -> Währungsdialog), Gewicht und Anzahl
    (±-Pfeile nur bei stapelbaren Items). Beschreibung = erster Tab mit den
    beiden Checkbox-Feldern Artefakt/Stapelbar; Kraft-Tab nur bei isArtifact
    (gemeinsames Partial, wie klassisch); Bonus-Tab. --}}
{{> systems/symbaroum/template/sheet/modern/item/header.hbs}}
    <div class="sheet-body m-item-body">
        <div class="tab" data-group="primary" data-tab="description">
            {{!-- Traditionen v1: zugeordnete Traditionen read-only (rendert nur bei vorhandenen Labels). --}}
            {{> systems/symbaroum/template/sheet/tab/traditions-display.hbs}}
            {{!-- Status-Tab v1 (02.11.): Die GM-Felder (Artefakt, Stapelbar,
                Ressourcen-Kategorie, „Ist alchemistisch?“ + Alchemie-
                eigenschaften) sind in den GM-only Status-Tab (data-tab=
                "stats", eigenes Partial tab-status.hbs) gezogen - das
                Beschreibungs-Panel ist wieder das reine Fill-Layout, der
                v1.2-Interim-Scroll-Fix (m-panel-ovY) entfällt komplett. --}}
            <div class="m-panel">
                <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                {{!-- Status-Tab v1.1 (Rudolfs Ergänzung): ReadOnly-
                    Alchemiestufe auf dem Beschreibungs-Tab - nur bei
                    alchemistisch=„Ja“, für Spieler sichtbar, nicht
                    editierbar; Wertpflege bleibt im Status-Tab. --}}
                {{#if alchemical}}
                <div class="alchemylevel-readonly">
                    <label>{{localize "ALCHEMY_LEVEL.LABEL"}}</label>
                    <span>{{alchemyLevelLabel}}</span>
                </div>
                {{/if}}
                {{!-- S4 v1.4 (Rudolfs Wunsch 2): „Anzahl Rationen“ ist vom
                    Beschreibungs-Tab ins Kopf-m-grid gezogen (header.hbs,
                    Optik wie das Anzahl-Feld) — dieser Block ist ENTFALLEN. --}}
                <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
            </div>
        </div>
        {{#if system.isArtifact}}
        {{> systems/symbaroum/template/sheet/tab/artifact.hbs}}
        {{/if}}
        {{!-- Status-Tab v1 (02.11.): GM-only, zwischen Beschreibung und Bonus --}}
        {{#if symbaroumOptions.isGM}}
        <div class="tab" data-group="primary" data-tab="stats">
            {{> systems/symbaroum/template/sheet/modern/item/tab-status.hbs}}
        </div>
        {{/if}}
        {{!-- v1.3: Bonus-Tab GM-only (Rudolfs Nachtest v1.2): Rail-Button UND Inhalt. --}}
        {{#if symbaroumOptions.isGM}}
        <div class="tab" data-group="primary" data-tab="bonus">
            {{> systems/symbaroum/template/sheet/modern/item/tab-bonus.hbs}}
        </div>
        {{/if}}
    </div>
</div>
    <nav class="modern-rail tabs sheet-tabs" data-group="primary" data-tooltip-direction="LEFT">
        <button type="button" class="modern-rail-btn" data-tab="description" data-tooltip="{{localize 'TAB.DESCRIPTION'}}"><i class="fas fa-feather-pointed"></i></button>
        {{#if system.isArtifact}}
        <button type="button" class="modern-rail-btn" data-tab="power" data-tooltip="{{localize 'TAB.POWER'}}"><i class="fas fa-wand-magic-sparkles"></i></button>
        {{/if}}
        {{#if symbaroumOptions.isGM}}<button type="button" class="modern-rail-btn" data-tab="stats" data-tooltip="{{localize 'TAB.STATS'}}"><i class="fas fa-gear"></i></button>{{/if}}
        {{#if symbaroumOptions.isGM}}<button type="button" class="modern-rail-btn" data-tab="bonus" data-tooltip="{{localize 'TAB.BONUS'}}"><i class="fas fa-gears"></i></button>{{/if}}
    </nav>
</div>
