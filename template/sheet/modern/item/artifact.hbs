{{!-- Item-Sheet-Modernisierung v1: Artefakt-Blatt (Typ artifact), modernisierte
    Ansicht. Kopf mit Gewicht und Anzahl (±-Pfeile nur bei stapelbaren
    Artefakten; AP2-Opt-in), kein Preis (klassisches Artefakt-Blatt hat keins);
    Stapelbar-Checkbox im Beschreibungs-tab; Kraft 1-3 + Bonus (klassische
    Tab-Struktur). --}}
{{> systems/symbaroum/template/sheet/modern/item/header.hbs typeLabelKey="ARTIFACT.NAME"}}
    <nav class="sheet-tabs tabs m-item-tabs" data-group="primary">
        <b class="item" data-tab="description">{{localize "TAB.DESCRIPTION"}}</b>
        <b class="item" data-tab="power1">{{localize "TAB.POWER"}} 1</b>
        <b class="item" data-tab="power2">{{localize "TAB.POWER"}} 2</b>
        <b class="item" data-tab="power3">{{localize "TAB.POWER"}} 3</b>
        <b class="item" data-tab="bonus">{{localize "TAB.BONUS"}}</b>
    </nav>
    <div class="sheet-body m-item-body">
        <div class="tab" data-group="primary" data-tab="description">
            <div class="m-panel">
                <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                <div class="m-row">
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.stackable">{{localize "STACK.LABEL"}}</label>
                        {{#if stackableChecked}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" checked data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{else}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{/if}}
                    </div>
                </div>
                <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="power1">
            <div class="m-panel">
                <h1>{{localize "TITLE.POWER"}} 1</h1>
                <div class="m-row">
                    <div class="m-inline-field">
                        <label for="{{id}}-system.power1.action">{{localize "ARTIFACT.ACTION"}}</label>
                        <select id="{{id}}-system.power1.action" name="system.power1.action">
                            {{selectOptions action_types selected=system.power1.action labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.power1.corruption">{{localize "ARTIFACT.CORRUPTION"}}</label>
                        <input id="{{id}}-system.power1.corruption" name="system.power1.corruption" type="text" value="{{system.power1.corruption}}"/>
                    </div>
                </div>
                <prose-mirror toggled name="system.power1.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.power1.description}}">{{{system.power1.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="power2">
            <div class="m-panel">
                <h1>{{localize "TITLE.POWER"}} 2</h1>
                <div class="m-row">
                    <div class="m-inline-field">
                        <label for="{{id}}-system.power2.action">{{localize "ARTIFACT.ACTION"}}</label>
                        <select id="{{id}}-system.power2.action" name="system.power2.action">
                            {{selectOptions action_types selected=system.power2.action labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.power2.corruption">{{localize "ARTIFACT.CORRUPTION"}}</label>
                        <input id="{{id}}-system.power2.corruption" name="system.power2.corruption" type="text" value="{{system.power2.corruption}}"/>
                    </div>
                </div>
                <prose-mirror toggled name="system.power2.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.power2.description}}">{{{system.power2.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="power3">
            <div class="m-panel">
                <h1>{{localize "TITLE.POWER"}} 3</h1>
                <div class="m-row">
                    <div class="m-inline-field">
                        <label for="{{id}}-system.power3.action">{{localize "ARTIFACT.ACTION"}}</label>
                        <select id="{{id}}-system.power3.action" name="system.power3.action">
                            {{selectOptions action_types selected=system.power3.action labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.power3.corruption">{{localize "ARTIFACT.CORRUPTION"}}</label>
                        <input id="{{id}}-system.power3.corruption" name="system.power3.corruption" type="text" value="{{system.power3.corruption}}"/>
                    </div>
                </div>
                <prose-mirror toggled name="system.power3.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.power3.description}}">{{{system.power3.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="bonus">
            {{> systems/symbaroum/template/sheet/tab/bonus.hbs}}
        </div>
    </div>
</div>
