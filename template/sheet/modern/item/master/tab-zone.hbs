{{!-- Konzept Runde 4 (Commit A, Master-Item-Sheet, Rudolfs Freigabe 25.11.):
    Gemeinsamer Slot-Partial "Zone (Mystische Kraft, GM-only)" - Inhalt VERBATIM aus den bisherigen
    Typ-Templates uebernommen (modern/item/*.hbs werden Duenne-Includes
    dieses Geroests); klassische Blaetter bleiben unberuehrt. --}}
<div class="tab" data-group="primary" data-tab="zone">
            <div class="m-panel">
                <h1>{{localize "AOE.TAB_LABEL"}}</h1>
                <div class="m-row m-zone-row">
                    {{!-- Hymnen-Paket 1.1 (Rudolfs Testrunde v1, Punkt Tanzende Waffe): Zonen-Schalter als ERSTES Feld — Nein deaktiviert die Kraft-Zone komplett (keine Teil-Konfigurations-Warnung, kein Ausführungsdialog, keine Platzierung). --}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.areaZone.active" data-tooltip="{{localize "AOE.INFO_ZONE_ACTIVE"}}">{{localize "AOE.FIELD_ZONE_ACTIVE"}}</label>
                        <select id="{{id}}-system.areaZone.active" name="system.areaZone.active">
                            {{selectOptions aoe_zone_active_selection selected=aoe.active valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.areaZone.shape">{{localize "AOE.FIELD_SHAPE"}}</label>
                        <select id="{{id}}-system.areaZone.shape" name="system.areaZone.shape">
                            {{selectOptions aoe_shape_selection selected=aoe.shape valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field m-zone-size">
                        <label for="{{id}}-system.areaZone.size" data-tooltip="{{localize "AOE.INFO_SIZE"}}">{{localize "AOE.FIELD_SIZE"}}</label>
                        <input id="{{id}}-system.areaZone.size" name="system.areaZone.size" type="number" min="1" value="{{aoe.size}}"/>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.areaZone.targeting" data-tooltip="{{localize "AOE.INFO_TARGETING"}}">{{localize "AOE.FIELD_TARGETING"}}</label>
                        <select id="{{id}}-system.areaZone.targeting" name="system.areaZone.targeting">
                            {{selectOptions aoe_targeting_selection selected=aoe.targeting valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                </div>
                <div class="m-row m-zone-row">
                    {{!-- AoE Stufe 2a (Freigabe 2a+2b, 09.11.2026): Wirkungsmodus (augenblicklich wirkt bei Platzierung wie Schlingranken, dauerhaft = Zone mit Karte), Betreten-Trigger und Dauer in Runden (0 = unbegrenzt). --}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.areaZone.mode" data-tooltip="{{localize "AOE.INFO_MODE"}}">{{localize "AOE.FIELD_MODE"}}</label>
                        <select id="{{id}}-system.areaZone.mode" name="system.areaZone.mode">
                            {{selectOptions aoe_mode_selection selected=aoe.mode valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.areaZone.trigger" data-tooltip="{{localize "AOE.INFO_TRIGGER"}}">{{localize "AOE.FIELD_TRIGGER"}}</label>
                        <select id="{{id}}-system.areaZone.trigger" name="system.areaZone.trigger">
                            {{selectOptions aoe_trigger_selection selected=aoe.trigger valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                </div>
                <div class="m-row m-zone-row">
                    {{!-- AoE v2.1 (Rudolfs Testrunde-1-Entscheidung 2, 10.11.): Zielwahl-Ordnung; das Dauer-Feld entfällt bei Augenblicklich (One-Shot-Zonen haben keine Restdauer). --}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.areaZone.targetOrder" data-tooltip="{{localize "AOE.INFO_TARGET_ORDER"}}">{{localize "AOE.FIELD_TARGET_ORDER"}}</label>
                        <select id="{{id}}-system.areaZone.targetOrder" name="system.areaZone.targetOrder">
                            {{selectOptions aoe_target_order_selection selected=aoe.targetOrder valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{!-- Baustein E (Rudolfs Startsignal „Leg los“ 16.11.2026): Wirker-Einbeziehung der Auto-Auswahl; Nie entfernt den Wirker auch beim Filter „Alle“, Immer erzwingt ihn über den Dispositionsfilter. --}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.areaZone.includeCaster" data-tooltip="{{localize "AOE.INFO_INCLUDE_CASTER"}}">{{localize "AOE.FIELD_INCLUDE_CASTER"}}</label>
                        <select id="{{id}}-system.areaZone.includeCaster" name="system.areaZone.includeCaster">
                            {{selectOptions aoe_include_caster_selection selected=aoe.includeCaster valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{!-- v1.3 F9a/F9b (Rudolfs Freigabe 20.11.): Autoplatzierung (Default AUS) - Zone wird bei Hymnen und Dornenmantel direkt mittig auf den Sänger gelegt; Versteckt (Default AUS) - fuer Spieler unsichtbare Zone (Sichtbarkeit SL), Wirkung laeuft weiter. --}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.areaZone.autoplace" data-tooltip="{{localize "AOE.INFO_AUTOPLACE"}}">{{localize "AOE.FIELD_AUTOPLACE"}}</label>
                        <input id="{{id}}-system.areaZone.autoplace" name="system.areaZone.autoplace" type="checkbox" {{checked aoe.autoplace}}/>
                    </div>
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.areaZone.hidden" data-tooltip="{{localize "AOE.INFO_HIDDEN"}}">{{localize "AOE.FIELD_HIDDEN"}}</label>
                        <input id="{{id}}-system.areaZone.hidden" name="system.areaZone.hidden" type="checkbox" {{checked aoe.hidden}}/>
                    </div>
                    {{!-- v1.4 (Rudolfs Freigabe 19.11. nach Testrunde 7): EIN Sinn je Zone (Core-
                        Ein-Typ-Grenze der Wall-Restriction) - Dropdown statt der drei Checkboxen;
                        Form-Clip ueber die native Region-Restriction + Ziel-Filter je Ausloesung. --}}
                    <div class="m-inline-field">
                        <label data-tooltip="{{localize "AOE.INFO_SENSE"}}">{{localize "AOE.FIELD_SENSE_BLOCKER"}}</label>
                        <div class="m-give-vis">
                            <select id="{{id}}-system.areaZone.sense" name="system.areaZone.sense">
                                {{selectOptions aoe_sense_selection selected=aoe.sense valueAttr="id" labelAttr="label"}}
                            </select>
                        </div>
                    </div>
                    {{#unless aoeIsInstant}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.areaZone.duration" data-tooltip="{{localize "AOE.INFO_DURATION"}}">{{localize "AOE.FIELD_DURATION"}}</label>
                        <input id="{{id}}-system.areaZone.duration" name="system.areaZone.duration" type="number" min="0" value="{{aoe.duration}}"/>
                    </div>
                    {{/unless}}
                </div>
                <p class="m-zone-hint">{{localize "AOE.INFO_SCALE"}}</p>
                <p class="m-zone-hint">{{localize "AOE.INFO_DEFAULTS"}}</p>
                {{!-- AoE v2.8: Sweep-Kraft (Rudolfs Grundsatz-Festlegung 13.11.) - Modus/Trigger/Dauer außer Kraft --}}
                {{#if aoeIsSweepPower}}
                <p class="m-zone-hint">{{localize "AOE.INFO_SWEEP"}}</p>
                {{/if}}
                {{#if aoeCanPlace}}
                <button type="button" class="m-zone-place" data-action="placeZone"><i class="fas fa-draw-polygon"></i> {{localize "AOE.PLACE_BUTTON"}}</button>
                {{else if aoeBlockedReason}}
                <p class="m-zone-hint">{{aoeBlockedReason}}</p>
                {{/if}}
            </div>
        </div>
