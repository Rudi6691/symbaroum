{{!-- Konzept Runde 4 (Commit A, Master-Item-Sheet, Rudolfs Freigabe 25.11.):
    Gemeinsamer Slot-Partial "Waffen-Stats (Typ weapon)" - Inhalt VERBATIM aus den bisherigen
    Typ-Templates uebernommen (modern/item/*.hbs werden Duenne-Includes
    dieses Geroests); klassische Blaetter bleiben unberuehrt. --}}
<div class="tab" data-group="primary" data-tab="stats">
            <div class="m-panel">
                <h1>{{localize "TITLE.STATS"}}</h1>
                <div class="m-grid">
                    {{!-- Status-Tab v1 (02.11.): GM-Block (Artefakt, Stapelbar,
                        Munition, Ressourcen-Kategorie) an den Anfang des
                        Stats-Grids gezogen - vor den Spieler-Zeilen. --}}
                    {{!-- Ressourcen v1, Testrunde 1 (Rudolfs Zusatzwunsch zu
                        Punkt 3): Artefakt- und Stapelbar-Checkbox sind
                        SL-Sache (Item-Taxonomie wie die Ressourcen-Kategorie)
                        - für Spieler ausgeblendet, der WERT bleibt erhalten. --}}
                    {{#if symbaroumOptions.isGM}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.isArtifact">{{localize "ITEM.ARTIFACT"}}</label>
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact" {{checked system.isArtifact}}/>
                    </div>
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.stackable">{{localize "STACK.LABEL"}}</label>
                        {{#if stackableChecked}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" checked data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{else}}
                        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
                        {{/if}}
                    </div>
                    {{!-- Sammel-Fix v1.2 (Rudolfs Testrunde 2, Befund 3):
                        „Traditionswissen?“ wandert vom eigenen Traditions-Tab
                        (v1) DIREKT hinter „Stapelbar“ INS Stats-m-grid —
                        Muster Ausrüstungs-Status-Tab v1.1; der Traditions-Tab
                        samt Rail-Button entfällt. inGrid=true schaltet das
                        Feld-Partial auf das m-inline-field-Spaltenlayout. --}}
                    {{> systems/symbaroum/template/sheet/tab/traditions-field.hbs inGrid=true}}
                    {{!-- Munitionsverbrauch v1 (31.10.): waffenseitige
                        Munitions-Konfiguration - GM-only wie Artefakt/
                        Stapelbar; leere Kategorie = kein Verbrauch, Menge
                        je Angriff (Standard 1). Ressourcen-Kategorie-Zeile
                        taggt die Waffe selbst als Munitions-Stapel. --}}
                    {{#if showAmmunition}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.ammunition.category" data-tooltip="{{localize "AMMO.CATEGORY_TOOLTIP"}}">{{localize "AMMO.CATEGORY_LABEL"}}</label>
                        <select id="{{id}}-system.ammunition.category" name="system.ammunition.category" data-tooltip="{{localize "AMMO.CATEGORY_TOOLTIP"}}">
                            {{selectOptions ammo_category_selection selected=ammunitionCategory valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.ammunition.amount" data-tooltip="{{localize "AMMO.AMOUNT_TOOLTIP"}}">{{localize "AMMO.AMOUNT_LABEL"}}</label>
                        <input id="{{id}}-system.ammunition.amount" name="system.ammunition.amount" type="number" value="{{ammunitionAmount}}" min="1" step="1" data-tooltip="{{localize "AMMO.AMOUNT_TOOLTIP"}}"/>
                    </div>
                    {{/if}}
                    {{#if showResourceCategory}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.resourceCategory" data-tooltip="{{localize "RESOURCE_CATEGORY.TOOLTIP"}}">{{localize "RESOURCE_CATEGORY.LABEL"}}</label>
                        <select id="{{id}}-system.resourceCategory" name="system.resourceCategory" data-tooltip="{{localize "RESOURCE_CATEGORY.TOOLTIP"}}">
                            {{selectOptions resource_category_selection selected=resourceCategory valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{/if}}
                    {{/if}}
                    <div class="m-inline-field">
                        <label for="{{id}}-system.attribute">{{localize "WEAPON.ATTRIBUTE"}}</label>
                        <select id="{{id}}-system.attribute" name="system.attribute">
                            {{selectOptions attribute_selection selected=system.attribute labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.reference">{{localize "WEAPON_CLASS.LABEL"}}</label>
                        <select id="{{id}}-system.reference" name="system.reference">
                            {{selectOptions weapon_type_selection selected=system.reference labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.baseDamage">{{localize "WEAPON.BASE_DAMAGE"}}</label>
                        <select id="{{id}}-system.baseDamage" name="system.baseDamage">
                            {{selectOptions weapon_damage_selection selected=system.baseDamage labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.bonusDamage">{{localize "WEAPON.BONUS_DAMAGE"}}</label>
                        <input id="{{id}}-system.bonusDamage" name="system.bonusDamage" type="text" value="{{system.bonusDamage}}"/>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.alternativeDamage">{{localize "TRAIT_LABEL.ALTERNATIVEDAMAGE"}}</label>
                        <select id="{{id}}-system.alternativeDamage" name="system.alternativeDamage">
                            {{selectOptions alternative_selection selected=system.alternativeDamage labelAttr="label"}}
                        </select>
                    </div>
                    <div class="m-inline-field">
                        <label for="{{id}}-system.quality">{{localize "WEAPON.QUALITY"}}</label>
                        <input id="{{id}}-system.quality" name="system.quality" type="text" value="{{system.quality}}"/>
                    </div>
                </div>
            </div>
        </div>
