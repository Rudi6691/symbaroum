{{!-- Item-Sheet-Modernisierung v1: Fähigkeits-Blatt, modernisierte Ansicht.
    Kopf über das gemeinsame Partial (Bild/Name, hier ohne Preis/Gewicht/Anzahl),
    Zeile 2 mit GM-Referenz und Aktivieren-Button. Beschreibung = erster
    Reiter-Tab, danach Novize/Adept/Meister (Aktion + Aktiv-Checkbox nur bei
    gehaltenem Item) und Bonus. --}}
{{> systems/symbaroum/template/sheet/modern/item/header.hbs}}
    <div class="sheet-body m-item-body">
        <div class="tab" data-group="primary" data-tab="description">
            <div class="m-panel">
                <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="novice">
            <div class="m-panel">
                <div class="m-row">
                    <div class="m-inline-field m-action-field">
                        <label for="{{id}}-system.novice.action">{{localize "ABILITY.ACTION"}}</label>
                        <select id="{{id}}-system.novice.action" name="system.novice.action">
                            {{selectOptions action_types selected=system.novice.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.novice.isActive">{{localize "ABILITY.ACTIVE"}}</label>
                        <input id="{{id}}-system.novice.isActive" name="system.novice.isActive" type="checkbox" value="active" {{checked system.novice.isActive}}/>
                    </div>
                    {{/if}}
                </div>
                <prose-mirror toggled name="system.novice.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.novice.description}}">{{{system.novice.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="adept">
            <div class="m-panel">
                <div class="m-row">
                    <div class="m-inline-field m-action-field">
                        <label for="{{id}}-system.adept.action">{{localize "ABILITY.ACTION"}}</label>
                        <select id="{{id}}-system.adept.action" name="system.adept.action">
                            {{selectOptions action_types selected=system.adept.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.adept.isActive">{{localize "ABILITY.ACTIVE"}}</label>
                        <input id="{{id}}-system.adept.isActive" name="system.adept.isActive" type="checkbox" value="active" {{checked system.adept.isActive}}/>
                    </div>
                    {{/if}}
                </div>
                {{!-- Bestienkunde v1.1 (Rudolfs Testrunde 1): Spezialisierung
                    in EIGENE Zeile UNTER der Aktion-Erlernt-Zeile --}}
                {{#if isBeastlore}}
                <div class="m-row">
                    <div class="m-inline-field m-action-field">
                        <label for="{{id}}-system.beastloreCategory">{{localize "ABILITY.BEASTLORE_CATEGORY"}}</label>
                        <select id="{{id}}-system.beastloreCategory" name="system.beastloreCategory">
                            {{selectOptions beastlore_category_selection selected=system.beastloreCategory labelAttr="label" valueAttr="id"}}
                        </select>
                    </div>
                </div>
                {{/if}}
                <prose-mirror toggled name="system.adept.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.adept.description}}">{{{system.adept.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="master">
            <div class="m-panel">
                <div class="m-row">
                    <div class="m-inline-field m-action-field">
                        <label for="{{id}}-system.master.action">{{localize "ABILITY.ACTION"}}</label>
                        <select id="{{id}}-system.master.action" name="system.master.action">
                            {{selectOptions action_types selected=system.master.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.master.isActive">{{localize "ABILITY.ACTIVE"}}</label>
                        <input id="{{id}}-system.master.isActive" name="system.master.isActive" type="checkbox" value="active" {{checked system.master.isActive}}/>
                    </div>
                    {{/if}}
                </div>
                <prose-mirror toggled name="system.master.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.master.description}}">{{{system.master.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="bonus">
            {{> systems/symbaroum/template/sheet/modern/item/tab-bonus.hbs}}
        </div>
    </div>
</div>
    <nav class="modern-rail tabs sheet-tabs" data-group="primary" data-tooltip-direction="LEFT">
        <button type="button" class="modern-rail-btn" data-tab="description" data-tooltip="{{localize 'TAB.DESCRIPTION'}}"><i class="fas fa-feather-pointed"></i></button>
        {{#ifn system.marker}}
        <button type="button" class="modern-rail-btn{{#if modern.levelLearned.novice}} m-level-learned{{/if}}" data-tab="novice" data-tooltip="{{localize 'TAB.NOVICE'}}"><i class="fas fa-seedling"></i></button>
        <button type="button" class="modern-rail-btn{{#if modern.levelLearned.adept}} m-level-learned{{/if}}" data-tab="adept" data-tooltip="{{localize 'TAB.ADEPT'}}"><i class="fas fa-leaf"></i></button>
        <button type="button" class="modern-rail-btn{{#if modern.levelLearned.master}} m-level-learned{{/if}}" data-tab="master" data-tooltip="{{localize 'TAB.MASTER'}}"><i class="fas fa-crown"></i></button>
        {{/ifn}}
        <button type="button" class="modern-rail-btn" data-tab="bonus" data-tooltip="{{localize 'TAB.BONUS'}}"><i class="fas fa-gears"></i></button>
    </nav>
</div>
