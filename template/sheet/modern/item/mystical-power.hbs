{{!-- Item-Sheet-Modernisierung v1: Blatt der Mystischen Kraft, modernisierte
    Ansicht. Wie Fähigkeit, zusätzlich das Material-Feld im Beschreibungs-tab
    (klassische Position). --}}
{{> systems/symbaroum/template/sheet/modern/item/header.hbs typeLabelKey="MYSTICAL_POWER.NAME"}}
    <div class="m-main-row">
    <div class="sheet-body m-item-body">
        <div class="tab" data-group="primary" data-tab="description">
            <div class="m-panel">
                <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                <div class="m-row">
                    <div class="m-inline-field">
                        <label for="{{id}}-system.material">{{localize "MYSTICAL_POWER.MATERIAL"}}</label>
                        <input id="{{id}}-system.material" name="system.material" type="text" value="{{system.material}}"/>
                    </div>
                </div>
                <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="novice">
            <div class="m-panel">
                <div class="m-row">
                    <div class="m-inline-field">
                        <label for="{{id}}-system.novice.action">{{localize "MYSTICAL_POWER.ACTION"}}</label>
                        <select id="{{id}}-system.novice.action" name="system.novice.action">
                            {{selectOptions action_types selected=system.novice.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.novice.isActive">{{localize "MYSTICAL_POWER.ACTIVE"}}</label>
                        <input id="{{id}}-system.novice.isActive" name="system.novice.isActive" type="checkbox" value="active" {{checked system.novice.isActive}}/>
                    </div>
                    {{/if}}
                </div>
                <prose-mirror toggled name="system.novice.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.novice.description}}">{{{system.novice.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="adept">
            <div class="m-panel">
                <div class="m-row">
                    <div class="m-inline-field">
                        <label for="{{id}}-system.adept.action">{{localize "MYSTICAL_POWER.ACTION"}}</label>
                        <select id="{{id}}-system.adept.action" name="system.adept.action">
                            {{selectOptions action_types selected=system.adept.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.adept.isActive">{{localize "MYSTICAL_POWER.ACTIVE"}}</label>
                        <input id="{{id}}-system.adept.isActive" name="system.adept.isActive" type="checkbox" value="active" {{checked system.adept.isActive}}/>
                    </div>
                    {{/if}}
                </div>
                <prose-mirror toggled name="system.adept.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.adept.description}}">{{{system.adept.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="master">
            <div class="m-panel">
                <div class="m-row">
                    <div class="m-inline-field">
                        <label for="{{id}}-system.master.action">{{localize "MYSTICAL_POWER.ACTION"}}</label>
                        <select id="{{id}}-system.master.action" name="system.master.action">
                            {{selectOptions action_types selected=system.master.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="m-inline-field m-check">
                        <label for="{{id}}-system.master.isActive">{{localize "MYSTICAL_POWER.ACTIVE"}}</label>
                        <input id="{{id}}-system.master.isActive" name="system.master.isActive" type="checkbox" value="active" {{checked system.master.isActive}}/>
                    </div>
                    {{/if}}
                </div>
                <prose-mirror toggled name="system.master.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.master.description}}">{{{system.master.description}}}</prose-mirror>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="bonus">
            {{> systems/symbaroum/template/sheet/tab/bonus.hbs}}
        </div>
    <nav class="modern-rail tabs sheet-tabs" data-group="primary" data-tooltip-direction="LEFT">
        <button type="button" class="modern-rail-btn" data-tab="description" data-tooltip="{{localize 'TAB.DESCRIPTION'}}"><i class="fas fa-feather-pointed"></i></button>
        {{#ifn system.marker}}
        <button type="button" class="modern-rail-btn" data-tab="novice" data-tooltip="{{localize 'TAB.NOVICE'}}"><i class="fas fa-seedling"></i></button>
        <button type="button" class="modern-rail-btn" data-tab="adept" data-tooltip="{{localize 'TAB.ADEPT'}}"><i class="fas fa-leaf"></i></button>
        <button type="button" class="modern-rail-btn" data-tab="master" data-tooltip="{{localize 'TAB.MASTER'}}"><i class="fas fa-crown"></i></button>
        {{/ifn}}
        <button type="button" class="modern-rail-btn" data-tab="bonus" data-tooltip="{{localize 'TAB.BONUS'}}"><i class="fas fa-arrow-up"></i></button>
    </nav>
    </div>
</div>
</div>
