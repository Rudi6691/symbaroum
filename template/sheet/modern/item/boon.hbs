{{!-- Item-Sheet-Modernisierung v1: Segen-Blatt (Boon), modernisierte Ansicht.
    Kopf mit Level-Feld in Zeile 2, GM-Referenz; Tabs Beschreibung + Bonus
    (klassische Tab-Struktur). --}}
{{> systems/symbaroum/template/sheet/modern/item/header.hbs}}
    <div class="sheet-body m-item-body">
        <div class="tab" data-group="primary" data-tab="description">
            <div class="m-panel">
                {{!-- Sammel-Fix v1.1 (Testrunde 1): VW-Single-Select zusätzlich
                    im Beschreibungs-Tab — SPIELER-editierbar (GM-Tab-Kopie darf
                    gedoppelt bleiben). OHNE name-Attribut (das GM-Tab-Partial
                    trägt bereits name="system.traditions" — kein zweiter form-
                    assoziierter Select desselben Namens); Änderung direkt per
                    item.update (Listener in item.js, Muster Preisbasis). --}}
                {{#if tradition_knowledge.isForbiddenKnowledge}}
                <div class="traditions-row traditions-desc-row">
                    <label for="{{id}}-traditions-desc" data-tooltip="{{localize "TRADITION.VW_TOOLTIP"}}">{{localize "TRADITION.SELECT_LABEL"}}</label>
                    <select id="{{id}}-traditions-desc" data-traditions-desc data-tooltip="{{localize "TRADITION.VW_TOOLTIP"}}" {{ifThen editable '' 'disabled'}}>
                        <option value="" {{#unless tradition_knowledge.selected}}selected{{/unless}}>{{localize "TRADITION.SELECT_NONE"}}</option>
                        {{#each tradition_knowledge.knownSelection as | t |}}
                        <option value="{{t.id}}" {{#ife ../tradition_knowledge.selected t.id}}selected{{/ife}}>{{t.label}}</option>
                        {{/each}}
                    </select>
                </div>
                {{/if}}
                {{!-- Segen & Lasten S2 Baustein B (Rudolfs „Leg los“,
                    06.11.2026): Kontakte-Gruppierung am Kontakte-Segen,
                    moderne Ansicht — gleiche Felder/Listener wie das
                    klassische Blatt (data-contact-group /
                    data-contact-group-custom, Änderungen per item.update,
                    Muster VW-desc-Select). --}}
                {{#if showContactGroup}}
                <div class="traditions-row contact-group-row">
                    <label for="{{id}}-contactgroup" data-tooltip="{{localize "BOON.CONTACT_GROUP.TOOLTIP"}}">{{localize "BOON.CONTACT_GROUP.SELECT_LABEL"}}</label>
                    <select id="{{id}}-contactgroup" data-contact-group data-tooltip="{{localize "BOON.CONTACT_GROUP.TOOLTIP"}}" {{ifThen editable '' 'disabled'}}>
                        <option value="" {{#unless contactGroup}}selected{{/unless}}>{{localize "BOON.CONTACT_GROUP.NONE"}}</option>
                        {{#each contact_group_selection as |g|}}
                        <option value="{{g.id}}" {{#ife ../contactGroup g.id}}selected{{/ife}}>{{g.label}}</option>
                        {{/each}}
                        <option value="custom" {{#ife contactGroup "custom"}}selected{{/ife}}>{{localize "BOON.CONTACT_GROUP.CUSTOM"}}</option>
                    </select>
                    {{!-- S2.1-Fix (Testpunkt 30, Rudolfs Rückmeldung 07.11.,
                        dritter Anlauf): KEIN disabled-Input mehr (Foundry
                        dimmt solche Felder grau auf hell, CSS-Gegenregeln
                        griffen zweimal nicht) — sobald das Feld nicht
                        editierbar ist, reine TEXTANZEIGE im Input-Look.
                        Gespeicherter Text in normaler Schriftfarbe; leeres
                        Feld zeigt den Platzhalter kursiv (lesbar). --}}
                    {{#ife contactGroup "custom"}}
                    {{#if editable}}
                    <input type="text" id="{{id}}-contactgroup-custom" data-contact-group-custom value="{{contactGroupCustom}}" placeholder="{{localize "BOON.CONTACT_GROUP.CUSTOM_PLACEHOLDER"}}"/>
                    {{else}}
                    <span class="contact-group-custom-display {{#unless contactGroupCustom}}is-empty{{/unless}}" data-tooltip="{{localize "BOON.CONTACT_GROUP.TOOLTIP"}}">{{#if contactGroupCustom}}{{contactGroupCustom}}{{else}}{{localize "BOON.CONTACT_GROUP.CUSTOM_PLACEHOLDER"}}{{/if}}</span>
                    {{/if}}
                    {{else}}
                    <span class="contact-group-custom-display {{#unless contactGroupCustom}}is-empty{{/unless}}" data-tooltip="{{localize "BOON.CONTACT_GROUP.TOOLTIP"}}">{{#if contactGroupCustom}}{{contactGroupCustom}}{{else}}{{localize "BOON.CONTACT_GROUP.CUSTOM_PLACEHOLDER"}}{{/if}}</span>
                    {{/ife}}
                </div>
                {{/if}}
                {{!-- Traditionen v1: zugeordnete Traditionen read-only (rendert nur bei vorhandenen Labels). --}}
                {{> systems/symbaroum/template/sheet/tab/traditions-display.hbs}}
                <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
            </div>
        </div>
        {{!-- v1.3: Bonus-Tab GM-only (Rudolfs Nachtest v1.2): Rail-Button UND Inhalt. --}}
        {{#if symbaroumOptions.isGM}}
        <div class="tab" data-group="primary" data-tab="bonus">
            {{!-- S2.1-Fix (Testpunkt 29, Rudolfs Rückmeldung 07.11.):
                Bonus/Malus NUR hier im Bonus-Tab als reine TEXTANZEIGE
                (war vorher im geteilten Kopf, also auf jedem Tab, und
                als disabled-Input unleserlich gedimmt). Effective Wert
                aus item.js (context.bonusValueDisplay, Fallback
                bonusValue → Stufe → +1); der Stufen-Stepper im Kopf
                synchronisiert system.bonusValue. --}}
            <div class="m-inline-field m-bonusvalue-display">
                <label data-tooltip="{{localize 'BOON.BONUS_VALUE_TOOLTIP'}}">{{localize "BOON.BONUS_VALUE"}}</label>
                <span class="m-bonusvalue-display-value" data-tooltip="{{localize 'BOON.BONUS_VALUE_TOOLTIP'}}">{{bonusValueDisplay}}</span>
            </div>
            {{> systems/symbaroum/template/sheet/modern/item/tab-bonus.hbs}}
        </div>
        {{/if}}
        {{!-- Traditionen v1: GM-only „Traditionen“-Tab, modern. --}}
        {{#if symbaroumOptions.isGM}}
        <div class="tab" data-group="primary" data-tab="traditions">
            {{> systems/symbaroum/template/sheet/modern/item/tab-traditions.hbs}}
        </div>
        {{/if}}
    </div>
</div>
    <nav class="modern-rail tabs sheet-tabs" data-group="primary" data-tooltip-direction="LEFT">
        <button type="button" class="modern-rail-btn" data-tab="description" data-tooltip="{{localize 'TAB.DESCRIPTION'}}"><i class="fas fa-feather-pointed"></i></button>
        {{#if symbaroumOptions.isGM}}<button type="button" class="modern-rail-btn" data-tab="bonus" data-tooltip="{{localize 'TAB.BONUS'}}"><i class="fas fa-gears"></i></button>{{/if}}
        {{!-- Traditionen v1: Rail-Button „Traditionen“ GM-only (alle Blätter). --}}
        {{#if symbaroumOptions.isGM}}<button type="button" class="modern-rail-btn" data-tab="traditions" data-tooltip="{{localize 'TRADITION.TAB_LABEL'}}"><i class="fas fa-gear"></i></button>{{/if}}
    </nav>
</div>
