<div class="{{cssClass}}{{#if renderModern}} modern-item-root{{/if}}">
{{!-- Item-Sheet-Modernisierung v1: Zweig-Umschalter am Wurzel-Template
    (Muster player.hbs/A6) - schaltet ein User sein Aktorblatt global um,
    gilt die moderne Ansicht auch hier; der klassische Zweig bleibt
    UNVERÄNDERT. --}}
{{#if renderModern}}
{{> systems/symbaroum/template/sheet/modern/item/boon.hbs}}
{{else}}
    <div class="boon">
        <div class="sheet-header foreground border">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" data-tooltip="{{item.name}}"/>
            </div>
            <div class="wrapper-column">
                <div class="name">
                    <label for="{{id}}-name">{{localize "BOON.NAME"}}</label>
                    <input id="{{id}}-name" name="name" type="text" value="{{item.name}}"/>
                </div>
                <div class="level">
                    <label for="{{id}}-system.level">{{localize "BOON.LEVEL"}}</label>
                    <div class="boon-level-ctrl">
                        {{#if editable}}<button type="button" class="boon-level-btn" data-action="boonLevelMinus" data-tooltip="{{localize 'BOON.LEVEL_DECREASE'}}"><i class="fas fa-caret-left"></i></button>{{/if}}
                        <input id="{{id}}-system.level" name="system.level" type="text" value="{{system.level}}" data-dtype="Number"/>
                        {{#if editable}}<button type="button" class="boon-level-btn" data-action="boonLevelPlus" data-tooltip="{{localize 'BOON.LEVEL_INCREASE'}}"><i class="fas fa-caret-right"></i></button>{{/if}}
                    </div>
                </div>
                {{!-- S2.1 (P25): GM-only Bonus/Malus-Feld (system.bonusValue), Fallback-Kette bonusValue → Stufe → +1 (boon.js). --}}
                {{#if symbaroumOptions.isGM}}
                <div class="level bonus-value-row">
                    {{!-- S2.1-Fix (Testpunkt 15): reine Anzeige - der
                         Stufen-Stepper synchronisiert system.bonusValue. --}}
                    <label for="{{id}}-system.bonusValue" data-tooltip="{{localize 'BOON.BONUS_VALUE_TOOLTIP'}}">{{localize "BOON.BONUS_VALUE"}}</label>
                    <input id="{{id}}-system.bonusValue" name="system.bonusValue" type="text" value="{{system.bonusValue}}" data-dtype="Number" disabled/>
                </div>
                {{/if}}
                {{#ifat symbaroumOptions.isGM symbaroumOptions.allowShowReference }}
                <div class="name">
                    <label for="{{id}}-system.reference">{{localize "ABILITY.REFERENCE"}}</label>
                    <input id="{{id}}-system.reference" name="system.reference" type="text" value="{{system.reference}}"/>
                </div>
                {{/ifat}}
            </div>
        </div>

        <div class="sheet-tabs tabs" data-group="primary">
            <b class="item" data-tab="description">{{localize "TAB.DESCRIPTION"}}</b>
            {{!-- v1.3: Bonus-Tab GM-only (Rudolfs Nachtest v1.2) --}}{{#if symbaroumOptions.isGM}}<b class="item" data-tab="bonus">{{localize "TAB.BONUS"}}</b>{{/if}}
            {{!-- Traditionen v1 (Rudolfs Startsignal „Leg los“ 03.11.2026): „Traditionen“-Tab GM-only auf ALLEN Item-Blättern. --}}{{#if symbaroumOptions.isGM}}<b class="item" data-tab="traditions">{{localize "TRADITION.TAB_LABEL"}}</b>{{/if}}
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="description">
                {{!-- Sammel-Fix v1.1 (Rudolfs „Leg los“ 03.11.2026, Testrunde 1):
                    VW-Single-Select zusätzlich im Beschreibungs-Tab des Segen-
                    Blatts — SPIELER-editierbar (Spieler sehen den GM-Tab nicht;
                    die GM-Tab-Kopie darf gedoppelt bleiben, Rudolfs Erlaubnis).
                    Bewusst OHNE name-Attribut: das GM-Tab-Partial trägt bereits
                    name="system.traditions"; ein zweiter form-assoziierter
                    Select desselben Namens würde beim Submit gegen den anderen
                    Select arbeiten. Änderung wird direkt per item.update
                    geschrieben (Listener in item.js, Muster Preisbasis). --}}
                {{#if tradition_knowledge.isForbiddenKnowledge}}
                <div class="traditions-row traditions-desc-row">
                    <label for="{{id}}-traditions-desc" data-tooltip="{{localize "TRADITION.VW_TOOLTIP"}}">{{localize "TRADITION.SELECT_LABEL"}}</label>
                    <select id="{{id}}-traditions-desc" data-traditions-desc data-tooltip="{{localize "TRADITION.VW_TOOLTIP"}}" {{ifThen editable '' 'disabled'}}>
                        <option value="" {{#unless tradition_knowledge.selected}}selected{{/unless}}>{{localize "TRADITION.SELECT_NONE"}}</option>
                        {{#each tradition_knowledge.knownSelection as | t |}}
                        <option value="{{t.id}}" {{#ife ../tradition_knowledge.selected t.id}}selected{{/ife}}>{{t.label}}</option>
                        {{/each}}
                    </select>
                </div>
                {{/if}}
                {{!-- Segen & Lasten S2 Baustein B (Rudolfs „Leg los“,
                    06.11.2026): Kontakte-Gruppierung am Kontakte-Segen —
                    Single-Select der 7 offiziellen Fraktionen + „Eigene
                    Gruppierung“ mit freiem Textfeld (nur bei 'custom'
                    aktiv). Bewusst NICHT form-assoziiert (kein name-
                    Attribut): Änderungen laufen per item.update über den
                    data-contact-group-Listener (Muster VW-desc-Select);
                    Spieler-editierbar. --}}
                {{#if showContactGroup}}
                <div class="traditions-row contact-group-row">
                    <label for="{{id}}-contactgroup" data-tooltip="{{localize "BOON.CONTACT_GROUP.TOOLTIP"}}">{{localize "BOON.CONTACT_GROUP.SELECT_LABEL"}}</label>
                    <select id="{{id}}-contactgroup" data-contact-group data-tooltip="{{localize "BOON.CONTACT_GROUP.TOOLTIP"}}" {{ifThen editable '' 'disabled'}}>
                        <option value="" {{#unless contactGroup}}selected{{/unless}}>{{localize "BOON.CONTACT_GROUP.NONE"}}</option>
                        {{#each contact_group_selection as |g|}}
                        <option value="{{g.id}}" {{#ife ../contactGroup g.id}}selected{{/ife}}>{{g.label}}</option>
                        {{/each}}
                        <option value="custom" {{#ife contactGroup "custom"}}selected{{/ife}}>{{localize "BOON.CONTACT_GROUP.CUSTOM"}}</option>
                    </select>
                    {{#ife contactGroup "custom"}}
                    <input type="text" id="{{id}}-contactgroup-custom" data-contact-group-custom value="{{contactGroupCustom}}" placeholder="{{localize "BOON.CONTACT_GROUP.CUSTOM_PLACEHOLDER"}}" {{ifThen editable '' 'disabled'}}/>
                    {{else}}
                    <input type="text" id="{{id}}-contactgroup-custom" data-contact-group-custom value="{{contactGroupCustom}}" placeholder="{{localize "BOON.CONTACT_GROUP.CUSTOM_PLACEHOLDER"}}" disabled/>
                    {{/ife}}
                </div>
                {{/if}}
                {{!-- Traditionen v1: zugeordnete Traditionen read-only im
                    Beschreibungs-Tab (rendert nur bei vorhandenen Labels). --}}
                {{> systems/symbaroum/template/sheet/tab/traditions-display.hbs}}
                <div class="description foreground border">
                    <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                    <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
                </div>
            </div>
            {{!-- v1.3: Bonus-Tab GM-only (Rudolfs Nachtest v1.2): Reiter UND Inhalt - Spieler sehen den Tab nicht, Werte bleiben erhalten. --}}
            {{#if symbaroumOptions.isGM}}
            <div class="tab" data-group="primary" data-tab="bonus">
                {{> systems/symbaroum/template/sheet/tab/bonus.hbs}}
            </div>
            {{/if}}
            {{!-- Traditionen v1: GM-only „Traditionen“-Tab (Feld „Traditionswissen?“ + Zahnrad-Dialog; „Verbotenes Wissen“-Segen: Single-Select im selben Feld). --}}
            {{#if symbaroumOptions.isGM}}
            <div class="tab" data-group="primary" data-tab="traditions">
                {{> systems/symbaroum/template/sheet/tab/traditions.hbs}}
            </div>
            {{/if}}
        </div>
    </div>
{{/if}}
</div>
