{{!-- Status-Tab v1 (Rudolfs Freigabe 02.11.): GM-only „Status“-Tab auf dem
    Ausrüstungsblatt - zieht die GM-Felder aus dem Beschreibungs-Tab heraus
    (strukturelle Lösung des v1.2-Scroll-Interims). Reihenfolge nach Rudolfs
    Liste: Artefakt, Stapelbar, Ressourcen-Kategorie, „Ist alchemistisch?“,
    dann bei „Ja“ die Alchemieeigenschaften (Alchemiestufe, Verwendungsform,
    Munitionswirkung auf Munitions-Items, Wirkungsfelder im gemeinsamen
    Partial). Spieler sehen den Tab nicht (isGM-Gating am Tab-Eintrag und
    am Tab-Inhalt in equipment.hbs); die Werte bleiben erhalten.
    Zeilen-Styles sind tab-unabhängig (Selektoren .equipment .tab .number
    etc., verifiziert 02.11.). --}}
<div class="stats foreground border">
    <h1>{{localize "TITLE.STATS"}}</h1>
    {{!-- Ressourcen v1, Testrunde 1 (Rudolfs Zusatzwunsch zu Punkt 3):
        Artefakt- und Stapelbar-Checkbox sind SL-Sache (Item-Taxonomie wie
        die Ressourcen-Kategorie) - für Spieler ausgeblendet, der WERT
        bleibt erhalten. Der Tab selbst ist GM-only, das Gating hier ist
        ein zweiter Gürtel für direkte Partial-Nutzung. --}}
    {{#if symbaroumOptions.isGM}}
    {{!-- Status-Tab v1.1 (Rudolfs Ergänzung): Artefakt + Stapelbar in
        EINER Zeile (Muster moderne Rüstungsblatt-/m-grid-Doppelreihe);
        Zeilen-Styles der Kinder greifen weiter, .status-double-row setzt
        nur das Zeilen-Flex. --}}
    <div class="status-double-row">
    <div class="number">
        <label for="{{id}}-system.isArtifact">{{localize "ITEM.ARTIFACT"}}</label>
        {{#if system.isArtifact}}
        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact" checked/>
        {{else}}
        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact"/>
        {{/if}}
    </div>
    {{!-- AP2 v2 (Uniform-Regel): Die Stapelbar-Zeile ist IMMER sichtbar;
        Ausrüstung ohne Artefakt-Flag ist default stapelbar (Merge-on-Drop
        bleibt an - Rationen etc.); abwählen = expliziter Opt-out. Artefakt-
        Ausrüstung bleibt default NICHT stapelbar, anwählen = Opt-in.
        stackableChecked (item.js) zeigt den EFFEKTIVEN Zustand, damit der
        erste Form-Submit undefined nicht fälschlich als false festnagelt. --}}
    <div class="stackable">
        <label for="{{id}}-system.stackable">{{localize "STACK.LABEL"}}</label>
        {{#if stackableChecked}}
        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" checked data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
        {{else}}
        <input id="{{id}}-system.stackable" name="system.stackable" type="checkbox" value="true" data-tooltip="{{localize "STACK.TOOLTIP"}}"/>
        {{/if}}
    </div>
    </div>{{!-- /status-double-row --}}
    {{!-- Traditionen v1 (03.11.2026): „Traditionswissen?“ als Zeile im
        GM-Status-Tab (kein eigener Tab auf dem Ausrüstungsblatt — Rudolfs
        Struktur-Entscheid). Gate + Zahnrad-Dialog bzw. VW-Single-Select im
        gemeinsamen Feld-Partial. Sammel-Fix v1.1 (Testrunde 1): DIREKT
        hinter der Artefakt-/Stapelbar-Zeile statt am Tab-Ende. --}}
    {{> systems/symbaroum/template/sheet/tab/traditions-field.hbs}}
    {{!-- Ressourcen v1: Ressourcen-Kategorie (GM-only) - additives Feld
        system.resourceCategory statt Flags; steuert den kategorie-
        basierten Verbrauch (Medicus bucht Kraeuterarznei beim Wurf ab,
        Kontextmenü „Ressource verbrauchen“ am Inventar-Item). Leere
        Auswahl = keine Ressource. --}}
    {{#if showResourceCategory}}
    <div class="resourcecategory">
        <label for="{{id}}-system.resourceCategory" data-tooltip="{{localize "RESOURCE_CATEGORY.TOOLTIP"}}">{{localize "RESOURCE_CATEGORY.LABEL"}}</label>
        <select id="{{id}}-system.resourceCategory" name="system.resourceCategory" data-tooltip="{{localize "RESOURCE_CATEGORY.TOOLTIP"}}">
            {{selectOptions resource_category_selection selected=resourceCategory valueAttr="id" labelAttr="label"}}
        </select>
    </div>
    {{/if}}
    {{!-- Brauen v1 (02.11.): Labor-Qualität (system.facilityCategory) -
        steuert den Bonus auf die Scharfsinn-Probe des Brau-Dialogs
        (brewing.js): kein Labor = Brauen gesperrt, Feldlabor/„Werkstatt“
        +0, gutes Feldlabor +1, einfaches/stationäres Labor +2, gutes
        stationäres Labor +3. GM-only wie die Ressourcen-Kategorie. --}}
    {{#if showFacilityCategory}}
    <div class="resourcecategory">
        <label for="{{id}}-system.facilityCategory" data-tooltip="{{localize "FACILITY_CATEGORY.TOOLTIP"}}">{{localize "FACILITY_CATEGORY.LABEL"}}</label>
        <select id="{{id}}-system.facilityCategory" name="system.facilityCategory" data-tooltip="{{localize "FACILITY_CATEGORY.TOOLTIP"}}">
            {{selectOptions facility_category_selection selected=facilityCategory valueAttr="id" labelAttr="label"}}
        </select>
    </div>
    {{/if}}
    {{!-- Status-Tab v1: „Ist alchemistisch?“ (system.alchemical, ''/'true')
        - alleinige Auswertungs-Kanonik: Bei „Ja“ erscheinen die
        Alchemieeigenschaften, Kontextmenü „Elixier verwenden“ und
        useElixir-Router werten Verwendungsform/Wirkungsfelder NUR bei
        „Ja“ aus. Anzeige-Initial für Alt-Items: gefüllte Wirkungsfelder
        = „Ja“, nur Verwendungsform = „Nein“ (Tagging v7 schrieb die
        Verwendungsform auf alle Gear-Items); persistiert beim Speichern. --}}
    {{#if showElixirFields}}
    <div class="resourcecategory">
        <label for="{{id}}-system.alchemical" data-tooltip="{{localize "ELIXIR.ALCHEMICAL_TOOLTIP"}}">{{localize "ELIXIR.ALCHEMICAL_LABEL"}}</label>
        <select id="{{id}}-system.alchemical" name="system.alchemical" data-tooltip="{{localize "ELIXIR.ALCHEMICAL_TOOLTIP"}}">
            <option value="" {{#unless alchemical}}selected{{/unless}}>{{localize "ELIXIR.ALCHEMICAL_NO"}}</option>
            <option value="true" {{#if alchemical}}selected{{/if}}>{{localize "ELIXIR.ALCHEMICAL_YES"}}</option>
        </select>
    </div>
    {{#if showAlchemy}}
    {{!-- Elixier-Automatisierung v1: Alchemieeigenschaften (GM-only) -
        Alchemie-Stufe + Verwendungsform, Munitionswirkung nur auf
        Munitions-Items; Wirkungsfelder im gemeinsamen Partial. --}}
    <div class="resourcecategory">
        <label for="{{id}}-system.alchemyLevel" data-tooltip="{{localize "ALCHEMY_LEVEL.TOOLTIP"}}">{{localize "ALCHEMY_LEVEL.LABEL"}}</label>
        <select id="{{id}}-system.alchemyLevel" name="system.alchemyLevel" data-tooltip="{{localize "ALCHEMY_LEVEL.TOOLTIP"}}">
            {{selectOptions alchemy_level_selection selected=alchemyLevel valueAttr="id" labelAttr="label"}}
        </select>
    </div>
    <div class="resourcecategory">
        <label for="{{id}}-system.elixirUsage" data-tooltip="{{localize "ELIXIR.USAGE_TOOLTIP"}}">{{localize "ELIXIR.USAGE_LABEL"}}</label>
        <select id="{{id}}-system.elixirUsage" name="system.elixirUsage" data-tooltip="{{localize "ELIXIR.USAGE_TOOLTIP"}}">
            {{selectOptions elixir_usage_selection selected=elixirUsage valueAttr="id" labelAttr="label"}}
        </select>
    </div>
    {{#if showAmmoEffect}}
    <div class="resourcecategory">
        <label for="{{id}}-system.ammoEffect" data-tooltip="{{localize "AMMO_EFFECT.TOOLTIP"}}">{{localize "AMMO_EFFECT.LABEL"}}</label>
        <select id="{{id}}-system.ammoEffect" name="system.ammoEffect" data-tooltip="{{localize "AMMO_EFFECT.TOOLTIP"}}">
            {{selectOptions ammo_effect_selection selected=ammoEffect valueAttr="id" labelAttr="label"}}
        </select>
    </div>
    {{/if}}
    {{> systems/symbaroum/template/sheet/tab/elixir-effect.hbs}}
    {{/if}}
    {{/if}}
    {{/if}}
</div>
