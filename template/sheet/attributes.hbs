<div class="symbaroum attributes">
        <div class="sheet-header foreground border">
            <h1>{{localize "TITLE.ATTRIBUTES"}}</h1>
            <div class="col-header">
                <b class="item item-name">{{localize "ARMOR.NAME"}}</b>
                <b class="item">{{localize "ATTRIBUTE.BASE"}}</b>
                <b class="item">{{localize "ATTRIBUTE.MODIFIER"}}</b>
                <b class="item">{{localize "ATTRIBUTE.BONUS"}}</b>
                <b class="item">{{localize "HEALTH.TOUGHNESS_TOTAL"}}</b>
            </div>
            {{#each system.attributes as |attribute key|}}
            <div class="attArray">
                <label for="attr-{{../id}}-{{key}}-value" class="item-name" style="width: 100%">{{localize attribute.label}}</label>
                <input id="attr-{{../id}}-{{key}}-value" type="number" value="{{attribute.value}}" data-dtype="Number" />
                <input id="attr-{{key}}-mod" type="number" value="{{attribute.temporaryMod}}" data-dtype="Number" />
                <input id="attr-{{key}}-bonus" type="number" value="{{attribute.bonus}}" disabled data-dtype="Number" />
                <input id="attr-{{key}}-total" type="number" value="{{attribute.total}}" disabled data-dtype="Number" />
            </div>
            {{/each}}
            {{!-- Hunger-Paket v1 (Rudolfs Option A, 09.11.2026): gesperrte
                  Hinweiszeile unter dem Grid — reine Textanzeige (KEIN
                  disabled-Input, S2.1-Lernweis Foundry-Dimming-Sackgasse),
                  nur bei aktivem Hunger-Malus. Der Malus ist bereits im
                  Stärke-Gesamtwert enthalten (actor.js zieht das Flag direkt
                  ab); die Zeile ist reine Anzeige, nichts wird abgezogen. --}}
            {{#if hungerPenalty}}
            <div class="attHungerRow" title="{{localize "TRAVEL.STRENGTH_AUTOPARAM_HINT"}}">
                <span class="attHungerLabel">{{localize "TRAVEL.STRENGTH_AUTOPARAM_LABEL"}}</span>
                <span class="attHungerValue">-{{hungerPenalty}}</span>
                <span class="attHungerHint">{{localize "TRAVEL.STRENGTH_ATTR_DIALOG_HINT"}}</span>
            </div>
            {{/if}}
        </div>
    </div>