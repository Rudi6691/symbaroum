<div class="{{cssClass}}{{#if renderModern}} modern-item-root{{/if}}">
{{!-- Item-Sheet-Modernisierung v1: Zweig-Umschalter am Wurzel-Template
    (Muster player.hbs/A6) - schaltet ein User sein Aktorblatt global um,
    gilt die moderne Ansicht auch hier; der klassische Zweig bleibt
    UNVERÄNDERT. --}}
{{#if renderModern}}
{{> systems/symbaroum/template/sheet/modern/item/mystical-power.hbs}}
{{else}}
    <div class="mystical-power">
        <div class="sheet-header foreground border">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" data-tooltip="{{item.name}}"/>
            </div>
            <div class="wrapper-column">
                <div class="name">
                <label for="{{id}}-name" >{{localize "MYSTICAL_POWER.NAME"}}</label>
                    <input id="{{id}}-name" name="name" type="text" value="{{item.name}}"/>
                </div>
                {{#ifat symbaroumOptions.isGM symbaroumOptions.allowShowReference }}
                <div class="name">
                    <label for="{{id}}-system.reference" >{{localize "ABILITY.REFERENCE"}}</label>
                    <input id="{{id}}-system.reference" name="system.reference" type="text" value="{{system.reference}}"/>
                </div>
                {{/ifat}}                
            </div>
            <div class="avatar">
                    <button type="button" class="activate-ability" data-action="activateAbility"><img src="icons/vtt-512.png" /></button>
            </div>
        </div>

        <div class="sheet-tabs tabs" data-group="primary">
            <b class="item" data-tab="description">{{localize "TAB.DESCRIPTION"}}</b>
            <b class="item" data-tab="novice">{{localize "TAB.NOVICE"}}</b>
            <b class="item" data-tab="adept">{{localize "TAB.ADEPT"}}</b>
            <b class="item" data-tab="master">{{localize "TAB.MASTER"}}</b>
            {{!-- v1.3: Bonus-Tab GM-only (Rudolfs Nachtest v1.2) --}}{{#if symbaroumOptions.isGM}}<b class="item" data-tab="bonus">{{localize "TAB.BONUS"}}</b>{{/if}}
            {{!-- Traditionen v1 (Rudolfs Startsignal „Leg los“ 03.11.2026): „Traditionen“-Tab GM-only auf ALLEN Item-Blättern. --}}{{#if symbaroumOptions.isGM}}<b class="item" data-tab="traditions">{{localize "TRADITION.TAB_LABEL"}}</b>{{/if}}
            {{!-- AoE Stufe 1 (Rudolfs Startsignal „Leg los“ 09.11.2026): „Zone“-Tab GM-only auf dem Mystische-Kraft-Blatt. --}}{{#if showAoeZoneTab}}<b class="item" data-tab="zone">{{localize "AOE.TAB_LABEL"}}</b>{{/if}}
        </div>

        <div class="sheet-body">
            <div class="tab" data-group="primary" data-tab="description">
                {{!-- Traditionen v1: zugeordnete Traditionen read-only im
                    Beschreibungs-Tab (rendert nur bei vorhandenen Labels). --}}
                {{> systems/symbaroum/template/sheet/tab/traditions-display.hbs}}
                <div class="description foreground border">
                    <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                    <div class="material">
                        <label for="{{id}}-system.material">{{localize "MYSTICAL_POWER.MATERIAL"}}</label>
                        <input id="{{id}}-system.material" name="system.material" type="text" value="{{system.material}}"/>
                    </div>
                    <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
                </div>
            </div>
            <div class="tab" data-group="primary" data-tab="novice">
                <div class="novice foreground border">
                    <h1>{{localize "TITLE.NOVICE"}}</h1>
                    <div class="action">
                        <label for="{{id}}-system.novice.action" >{{localize "MYSTICAL_POWER.ACTION"}}</label>
                        <select id="{{id}}-system.novice.action" name="system.novice.action">
                            {{selectOptions action_types selected=system.novice.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="active">
                        <label for="{{id}}-system.novice.isActive">{{localize "MYSTICAL_POWER.ACTIVE"}}</label>
                        <input id="{{id}}-system.novice.isActive" name="system.novice.isActive" type="checkbox" value="active" {{checked system.novice.isActive}}/>
                    </div>
                    {{/if}}
                    <prose-mirror toggled name="system.novice.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.novice.description}}">{{{system.novice.description}}}</prose-mirror>
                </div>
            </div>
            <div class="tab" data-group="primary" data-tab="adept">
                <div class="adept foreground border">
                    <h1>{{localize "TITLE.ADEPT"}}</h1>
                    <div class="action">
                        <label for="{{id}}-system.adept.action">{{localize "MYSTICAL_POWER.ACTION"}}</label>
                        <select id="{{id}}-system.adept.action" name="system.adept.action">
                            {{selectOptions action_types selected=system.adept.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="active">
                        <label for="{{id}}-system.adept.isActive">{{localize "MYSTICAL_POWER.ACTIVE"}}</label>
                        <input id="{{id}}-system.adept.isActive" name="system.adept.isActive" type="checkbox" value="active" {{checked system.adept.isActive}}/>
                    </div>
                    {{/if}}    
                    <prose-mirror toggled name="system.adept.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.adept.description}}">{{{system.adept.description}}}</prose-mirror>
                </div>
            </div>
            <div class="tab" data-group="primary" data-tab="master">
                <div class="master foreground border">
                    <h1>{{localize "TITLE.MASTER"}}</h1>
                    <div class="action">
                        <label for="{{id}}-system.master.action">{{localize "MYSTICAL_POWER.ACTION"}}</label>
                        <select id="{{id}}-system.master.action" name="system.master.action">
                            {{selectOptions action_types selected=system.master.action labelAttr="label"}}
                        </select>
                    </div>
                    {{#if isOwned}}
                    <div class="active">
                        <label for="{{id}}-system.master.isActive">{{localize "MYSTICAL_POWER.ACTIVE"}}</label>
                        <input id="{{id}}-system.master.isActive" name="system.master.isActive" type="checkbox" value="active" {{checked system.master.isActive}}/>
                    </div>
                    {{/if}}
                    <prose-mirror toggled name="system.master.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.master.description}}">{{{system.master.description}}}</prose-mirror>
                </div>
            </div>
            {{!-- v1.3: Bonus-Tab GM-only (Rudolfs Nachtest v1.2): Reiter UND Inhalt - Spieler sehen den Tab nicht, Werte bleiben erhalten. --}}
            {{#if symbaroumOptions.isGM}}
            <div class="tab" data-group="primary" data-tab="bonus">
                {{> systems/symbaroum/template/sheet/tab/bonus.hbs}}
            </div>
            {{/if}}
            {{!-- Traditionen v1: GM-only „Traditionen“-Tab (Feld „Traditionswissen?“ + Zahnrad-Dialog; „Verbotenes Wissen“-Segen: Single-Select im selben Feld). --}}
            {{#if symbaroumOptions.isGM}}
            <div class="tab" data-group="primary" data-tab="traditions">
                {{> systems/symbaroum/template/sheet/tab/traditions.hbs}}
            </div>
            {{/if}}
            {{!-- AoE Stufe 1 (Rudolfs Startsignal „Leg los“ 09.11.2026): GM-only
                „Zone“-Tab (klassische Ansicht) — dieselben Felder wie der moderne
                Tab (system.areaZone.shape/size/targeting, form-assoziiert) plus
                Platzier-Knopf; Hinweise 1 Feld = 2 m und RAW-Empfehlung. --}}
            {{#if showAoeZoneTab}}
            <div class="tab" data-group="primary" data-tab="zone">
                <div class="stats foreground border">
                    <h1>{{localize "AOE.TAB_LABEL"}}</h1>
                    <div class="action">
                        <label for="{{id}}-system.areaZone.shape">{{localize "AOE.FIELD_SHAPE"}}</label>
                        <select id="{{id}}-system.areaZone.shape" name="system.areaZone.shape">
                            {{selectOptions aoe_shape_selection selected=aoe.shape valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    <div class="action">
                        <label for="{{id}}-system.areaZone.size" data-tooltip="{{localize "AOE.INFO_SIZE"}}">{{localize "AOE.FIELD_SIZE"}}</label>
                        <input id="{{id}}-system.areaZone.size" name="system.areaZone.size" type="number" min="1" value="{{aoe.size}}"/>
                    </div>
                    <div class="action">
                        <label for="{{id}}-system.areaZone.targeting" data-tooltip="{{localize "AOE.INFO_TARGETING"}}">{{localize "AOE.FIELD_TARGETING"}}</label>
                        <select id="{{id}}-system.areaZone.targeting" name="system.areaZone.targeting">
                            {{selectOptions aoe_targeting_selection selected=aoe.targeting valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{!-- AoE Stufe 2a (Freigabe 2a+2b, 09.11.2026): Wirkungsmodus (augenblicklich wirkt bei Platzierung wie Schlingranken, dauerhaft = Zone mit Karte), Betreten-Trigger und Dauer in Runden (0 = unbegrenzt). --}}
                    <div class="action">
                        <label for="{{id}}-system.areaZone.mode" data-tooltip="{{localize "AOE.INFO_MODE"}}">{{localize "AOE.FIELD_MODE"}}</label>
                        <select id="{{id}}-system.areaZone.mode" name="system.areaZone.mode">
                            {{selectOptions aoe_mode_selection selected=aoe.mode valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    <div class="action">
                        <label for="{{id}}-system.areaZone.trigger" data-tooltip="{{localize "AOE.INFO_TRIGGER"}}">{{localize "AOE.FIELD_TRIGGER"}}</label>
                        <select id="{{id}}-system.areaZone.trigger" name="system.areaZone.trigger">
                            {{selectOptions aoe_trigger_selection selected=aoe.trigger valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{!-- AoE v2.1 (Rudolfs Testrunde-1-Entscheidung 2, 10.11.): Zielwahl-Ordnung; das Dauer-Feld entfällt bei Augenblicklich (One-Shot-Zonen haben keine Restdauer). --}}
                    <div class="action">
                        <label for="{{id}}-system.areaZone.targetOrder" data-tooltip="{{localize "AOE.INFO_TARGET_ORDER"}}">{{localize "AOE.FIELD_TARGET_ORDER"}}</label>
                        <select id="{{id}}-system.areaZone.targetOrder" name="system.areaZone.targetOrder">
                            {{selectOptions aoe_target_order_selection selected=aoe.targetOrder valueAttr="id" labelAttr="label"}}
                        </select>
                    </div>
                    {{#unless aoeIsInstant}}
                    <div class="action">
                        <label for="{{id}}-system.areaZone.duration" data-tooltip="{{localize "AOE.INFO_DURATION"}}">{{localize "AOE.FIELD_DURATION"}}</label>
                        <input id="{{id}}-system.areaZone.duration" name="system.areaZone.duration" type="number" min="0" value="{{aoe.duration}}"/>
                    </div>
                    {{/unless}}
                    <p class="zone-hint">{{localize "AOE.INFO_SCALE"}}</p>
                    <p class="zone-hint">{{localize "AOE.INFO_DEFAULTS"}}</p>
                    {{#if aoeCanPlace}}
                    <button type="button" class="zone-place" data-action="placeZone"><i class="fas fa-draw-polygon"></i> {{localize "AOE.PLACE_BUTTON"}}</button>
                    {{else if aoeBlockedReason}}
                    <p class="zone-hint">{{aoeBlockedReason}}</p>
                    {{/if}}
                </div>
            </div>
            {{/if}}
        </div>
    </div>
{{/if}}
</div>
