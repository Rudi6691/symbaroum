<div class="{{cssClass}}">
    <div class="container">
        <div class="sheet-header foreground border">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" data-tooltip="{{item.name}}"/>
            </div>
            <div class="wrapper-column">
                <div class="name">
                    <label for="{{id}}-name">{{localize "EQUIPMENT.NAME"}}</label>
                    <input name="name" id="{{id}}-name" type="text" value="{{item.name}}"/>
                </div>
            </div>
        </div>
        <div class="sheet-body">
            {{!-- Testrunde-1-Wunsch (11b): Layout exakt am Ausrüstungs-Blatt -
                gleicher Wrapper (.container analog .equipment), gleiche .tab-Struktur
                und gleiche Feldreihenfolge (Kosten, Anzahl-artige Zeile, Gewicht,
                Artefakt-Checkbox), damit die per Typ gescopeten CSS-Regeln greifen. --}}
            <div class="tab" data-group="primary" data-tab="description">
                <div class="description foreground border">
                    <h1>{{localize "TITLE.DESCRIPTION"}}</h1>
                    <div class="cost">
                        <label>{{localize "EQUIPMENT.COST"}}</label>
                        {{!-- A38-Muster: Preisfeld mit Zahl + Einheit; konvertierte Behälter
                            bringen ihr migriertes price mit, Neuanlagen bekommen es aus dem
                            Template des (neuen, A38-sicheren) Typs. --}}
                        {{#if (priceExists item)}}
                        <input type="number" min="0" step="1" data-dtype="Number" name="system.price.value" id="{{id}}-system.price.value" value="{{item.system.price.value}}"/>
                        <select name="system.price.denomination" id="{{id}}-system.price.denomination">{{{priceDenominations item}}}</select>
                        {{else}}
                        <span class="price-migration-hint">{{localize "PRICE.MIGRATION_HINT"}}</span>
                        {{/if}}
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.capacity">{{localize "CONTAINER.CAPACITY"}}</label>
                        <input id="{{id}}-system.capacity" name="system.capacity" type="number" min="0" step="0.5" data-dtype="Number" value="{{item.system.capacity}}" data-tooltip="{{localize "CONTAINER.CAPACITY_TOOLTIP"}}"/>
                    </div>
                    <div class="weight">
                        <label for="{{id}}-system.weight">{{localize "WEIGHT.LABEL"}}</label>
                        <select id="{{id}}-system.weight" name="system.weight" data-tooltip="{{localize "WEIGHT.TOOLTIP"}}">{{{weightOptions item}}}</select>
                    </div>
                    {{!-- Testrunde-1-Wunsch (11c): Artefakt-Checkbox + Label wie auf dem
                        Ausrüstungs-/Waffen-/Rüstungs-Blatt (gleiche Zeile, gleiches Markup;
                        reines Kennzeichen, z. B. für magische Behälter). --}}
                    <div class="number">
                        <label for="{{id}}-system.isArtifact">{{localize "ITEM.ARTIFACT"}}</label>
                        {{#if system.isArtifact}}
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact" checked/>
                        {{else}}
                        <input id="{{id}}-system.isArtifact" name="system.isArtifact" type="checkbox" value="artifact"/>
                        {{/if}}
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.carried">{{localize "CONTAINER.CARRIED"}}</label>
                        {{#if system.carried}}
                        <input id="{{id}}-system.carried" name="system.carried" type="checkbox" value="carried" data-dtype="Boolean" checked/>
                        {{else}}
                        <input id="{{id}}-system.carried" name="system.carried" type="checkbox" value="carried" data-dtype="Boolean"/>
                        {{/if}}
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.countLoad">{{localize "CONTAINER.COUNT_LOAD"}}</label>
                        {{!-- carried = false erzwingt countLoad = false (Implikation); das
                            Feld bleibt hier bewusst einfach editierbar - die Enforcement
                            läuft über die Blatt-Dialoge, das Blatt folgt beim Speichern. --}}
                        {{#if system.countLoad}}
                        <input id="{{id}}-system.countLoad" name="system.countLoad" type="checkbox" value="countLoad" data-dtype="Boolean" checked/>
                        {{else}}
                        <input id="{{id}}-system.countLoad" name="system.countLoad" type="checkbox" value="countLoad" data-dtype="Boolean"/>
                        {{/if}}
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.weightlessContents">{{localize "CONTAINER.WEIGHTLESS"}}</label>
                        {{#if system.weightlessContents}}
                        <input id="{{id}}-system.weightlessContents" name="system.weightlessContents" type="checkbox" value="weightlessContents" data-dtype="Boolean" checked/>
                        {{else}}
                        <input id="{{id}}-system.weightlessContents" name="system.weightlessContents" type="checkbox" value="weightlessContents" data-dtype="Boolean"/>
                        {{/if}}
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.icon">{{localize "CONTAINER.ICON"}}</label>
                        <input id="{{id}}-system.icon" name="system.icon" type="text" value="{{item.system.icon}}" placeholder="fas fa-suitcase" data-tooltip="{{localize "CONTAINER.ICON_TOOLTIP"}}"/>
                    </div>
                    <div class="number">
                        <label for="{{id}}-system.currency">{{localize "CONTAINER.CURRENCY_LABEL"}}</label>
                        <input id="{{id}}-system.currency" name="system.currency" type="number" min="0" step="1" data-dtype="Number" value="{{item.system.currency}}" data-tooltip="{{localize "CONTAINER.CURRENCY_SHEET_HINT"}}"/>
                    </div>
                    <prose-mirror toggled name="system.description" {{ifThen editable '' 'disabled'}} value="{{rawSystem.description}}">{{{system.description}}}</prose-mirror>
                </div>
            </div>
        </div>
    </div>
</div>
