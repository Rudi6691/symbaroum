{{!-- Alchemie Modul 3: Analyse-Dialog. Elixier-Auswahl (Inventar zuerst,
    dann Welt-Items, Cap wirksame Stufe+2), Geleitet-Auswahl (erhöht die
    wirksame Stufe und erweitert die Kandidaten live), Labor-Dropdown mit
    LAB_NONE-Option (Analysieren ist ohne Labor erlaubt), freier Modifikator
    und Info-Zeile (Stufe/Modifikator, live gesetzt via onRender).
    v1.6 (Rudolfs Testrunde v1.5, Punkte 3+4, Freigabe Variante A):
    Info-Zeile readonly + volle Breite statt deaktiviert/schmal —
    Stufe/Modifikator werden nie mehr abgeschnitten.
    Muster: brew-dialog.hbs (renderTemplate mit vollem Pfad, kein Partial,
    theme-adaptive Zweige über renderModern; KEIN templatePaths-Eintrag).
    v1.7 (Rudolfs Testrunde v1.6, Freigabe 04.11.): Ein-/Ausgabefelder
    25 % breiter bei UNVERÄNDERTER Dialogbreite — klassische Labels
    schrumpfen auf Textbreite (Felder füllen den freigewordenen Platz),
    moderner Feld-Deckel 9rem → 11.25rem (+25 % exakt), gescoped über
    die Root-Klasse symb-alch. Info-Zeile gestapelt (Label „Probe“ oben,
    Feld darunter voll breit) als readonly-Textarea (bricht um statt
    abzuschneiden; Inhalt serverseitig aus dem info-Kontext, .value-API
    identisch, brewing.js unberührt). --}}
<div class="symbaroum symb-alch{{#if renderModern}} modern-roll-dialog{{else}} dialog{{/if}}">
  {{!-- v1.7: Felder 25 % breiter — gescoped über .symb-alch (nur die
      Alchemie-Dialoge tragen die Klasse, andere Systemdialoge unberührt;
      kein !important im System-CSS auf den überschriebenen Regeln). --}}
  <style>
    .symbaroum.dialog.symb-alch .attribute > label { width:auto; min-width:0; flex:0 0 auto; }
    .symbaroum.modern-roll-dialog.symb-alch .m-roll-row input[type=number],
    .symbaroum.modern-roll-dialog.symb-alch .m-roll-row input[type=text],
    .symbaroum.modern-roll-dialog.symb-alch .m-roll-row select { flex:0 0 11.25rem; width:11.25rem; box-sizing:border-box; }
  </style>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="analyse-elixir">{{localize "ANALYSE.SELECT"}}</label>
    <select id="analyse-elixir">
      {{selectOptions candidates selected=preselect valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="analyse-guide">{{localize "ANALYSE.GUIDE"}}</label>
    <select id="analyse-guide" data-tooltip="{{localize "ANALYSE.GUIDE_TOOLTIP"}}">
      {{selectOptions guides selected=guideId valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="analyse-lab">{{localize "BREW.LAB"}}</label>
    <select id="analyse-lab" data-tooltip="{{localize "BREW.LAB_TOOLTIP"}}">
      {{selectOptions facilities selected=labId valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="analyse-modifier">{{localize "DIALOG.MODIFIER"}}</label>
    <input id="analyse-modifier" type="number" value="0"/>
  </div>
  {{!-- Sammel-Fix v1.3 (Rudolfs Testrunde v1.2, Punkt 6c): Gunst-Block
      (Normal/Gunst/Missgunst) wie der kanonische Würfeldialog HINTER dem
      Modifikator — brewing.js reicht favour an baseRoll durch. --}}
  {{#if renderModern}}
  <fieldset class="m-ability-frame">
    <legend class="m-ability-label">{{localize "DIALOG.FAVOUR_LEGEND"}}</legend>
    <div class="m-give-vis">
      <label class="lblfavour">
        <input type="radio" name="analyse-favour" value="0" checked/>
        {{localize "DIALOG.FAVOUR_NORMAL"}}
      </label>
      <label class="lblfavour">
        <input type="radio" name="analyse-favour" value="1"/>
        {{localize "DIALOG.FAVOUR_FAVOUR"}}
      </label>
      <label class="lblfavour">
        <input type="radio" name="analyse-favour" value="-1"/>
        {{localize "DIALOG.FAVOUR_DISFAVOUR"}}
      </label>
    </div>
  </fieldset>
  {{else}}
  <div class="favour">
    <label class="lblfavour">
      <input type="radio" name="analyse-favour" value="0" checked/>
      {{localize "DIALOG.FAVOUR_NORMAL"}}
    </label>
    <label class="lblfavour">
      <input type="radio" name="analyse-favour" value="1"/>
      {{localize "DIALOG.FAVOUR_FAVOUR"}}
    </label>
    <label class="lblfavour">
      <input type="radio" name="analyse-favour" value="-1"/>
      {{localize "DIALOG.FAVOUR_DISFAVOUR"}}
    </label>
  </div>
  {{/if}}
  {{!-- Segen & Lasten S2 Baustein A (Rudolfs „Leg los“, 06.11.2026):
      Grüner-Daumen-Zeile — nur bei Besitz des Segens (greenthumb null
      sonst). Bonus addiert sich opt-in per Häkchen auf die Analyse-
      Probe. --}}
  {{#if greenthumb}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="analyse-greenthumb" data-tooltip="{{localize "BOON.LINE_GREENTHUMB_TOOLTIP"}}">{{greenthumb.label}}</label>
    <input id="analyse-greenthumb" type="checkbox"/>
  </div>
  {{/if}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}" style="flex-wrap:wrap">
    <label for="analyse-info" style="flex:0 0 100%; width:100%; min-width:0;">{{localize "ANALYSE.INFO_LABEL"}}</label>
    <textarea id="analyse-info" rows="2" readonly style="width:100%; max-width:100%; box-sizing:border-box; color:inherit; resize:none; text-align:left;">{{info}}</textarea>
  </div>
</div>
