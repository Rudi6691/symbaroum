{{!-- AoE v2.2 (Rudolfs Testrunde 2, P4 - Rudolfs Design-Wunsch): Konfigurations-
      dialog der freien Zone im modernen Dialog-Design - symbDialog mit
      modernDialogClasses, Optik am Alchemie-/Brau-Dialog (brew-dialog.hbs-
      Muster): renderModern-Zweige, Zeilen modern als m-roll-row, klassisch
      als attribute, Option-Daten per selectOptions-Helper. Rendering via
      foundry.applications.handlebars.renderTemplate (kein Partial, kein
      preloadHandlebarsTemplates-Eintrag nötig). Feld-IDs unverändert zum
      v2.1-Dialog (aoe-free-*), _placeFreeZoneFromDialog liest sie weiter.
      v2.3 (Rudolfs Testrunde 3, Punkte 3+4+11): Neues Feld „Auslösen“
      (Nur Auslöse-Taste / Beim Betreten), Modifikator-Feld + Gunst-Block
      (Untersuchen-Dialog-Muster, investigate-dialog.hbs) zwischen
      Widerstands-Attribut und Schaden - _probeAuto würfelt beide,
      die Spieler-Anfragekarte übergibt sie an baseRoll. --}}
<div class="symbaroum symb-aoe{{#if renderModern}} modern-roll-dialog{{else}} dialog{{/if}}">
  <p class="aoe-free-hint">{{localize "AOE.FREE_HINT"}}</p>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-name">{{localize "AOE.FREE_NAME"}}</label>
    <input id="aoe-free-name" type="text" value="{{freeName}}"/>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-shape">{{localize "AOE.FIELD_SHAPE"}}</label>
    <select id="aoe-free-shape">
      {{selectOptions shapeOptions valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-size">{{localize "AOE.FIELD_SIZE"}}</label>
    <input id="aoe-free-size" type="number" min="1" value="3"/>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-targeting">{{localize "AOE.FIELD_TARGETING"}}</label>
    <select id="aoe-free-targeting">
      {{selectOptions targetingOptions valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-resist">{{localize "AOE.FIELD_RESIST"}}</label>
    <select id="aoe-free-resist">
      {{selectOptions attrOptions valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  {{!-- v2.3 (Punkt 11): Modifikator + Gunst wie der Untersuchungs-Dialog
      (Standard-Würfeldialog-Muster) - wirken auf die Widerstands-Probe
      der Zonen-Opfer, gespeichert in eff.modifier/eff.favour.
      v2.4 (Rudolfs Klärungsrunde): Der Modifikator gehört zur ZONE - das
      ZONENATTRIBUT ist 10 - Modifikator (exakt die Umkehrung der
      Symbaroum-Widerstandskonvertierung), der Live-Hinweis zeigt ihn
      während der Eingabe; das Widerstands-Attribut-Dropdown wählt das
      Attribut, auf das der ZIEL-Token würfelt. Die Gunst gehört ebenfalls
      zur Zone und spiegelt sich auf den Token-Wurf (siehe Favor-Hinweis). --}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-modifier">{{localize "DIALOG.MODIFIER"}}</label>
    <input id="aoe-free-modifier" type="number" value="0"/>
  </div>
  <p class="aoe-free-hint">{{localize "AOE.FREE_ZONEATTR_HINT"}} <b id="aoe-free-zoneattr-value">10</b></p>
  {{#if renderModern}}
  <fieldset class="m-ability-frame">
    <legend class="m-ability-label">{{localize "DIALOG.FAVOUR_LEGEND"}}</legend>
    <div class="m-give-vis">
      <label class="lblfavour">
        <input type="radio" name="aoe-free-favour" value="0" checked/>
        {{localize "DIALOG.FAVOUR_NORMAL"}}
      </label>
      <label class="lblfavour">
        <input type="radio" name="aoe-free-favour" value="1"/>
        {{localize "DIALOG.FAVOUR_FAVOUR"}}
      </label>
      <label class="lblfavour">
        <input type="radio" name="aoe-free-favour" value="-1"/>
        {{localize "DIALOG.FAVOUR_DISFAVOUR"}}
      </label>
    </div>
  </fieldset>
  {{else}}
  <div class="favour">
    <label class="lblfavour">
      <input type="radio" name="aoe-free-favour" value="0" checked/>
      {{localize "DIALOG.FAVOUR_NORMAL"}}
    </label>
    <label class="lblfavour">
      <input type="radio" name="aoe-free-favour" value="1"/>
      {{localize "DIALOG.FAVOUR_FAVOUR"}}
    </label>
    <label class="lblfavour">
      <input type="radio" name="aoe-free-favour" value="-1"/>
      {{localize "DIALOG.FAVOUR_DISFAVOUR"}}
    </label>
  </div>
  {{/if}}
  <p class="aoe-free-hint">{{localize "AOE.FREE_FAVOUR_HINT"}}</p>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-damage">{{localize "AOE.FIELD_DAMAGE"}}</label>
    <input id="aoe-free-damage" type="text" placeholder="1d6"/>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-dpr">{{localize "AOE.FIELD_DAMAGE_ROUND"}}</label>
    <input id="aoe-free-dpr" type="text" placeholder="1d4"/>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-corruption">{{localize "AOE.FIELD_CORRUPTION"}}</label>
    <input id="aoe-free-corruption" type="text" placeholder="1d4"/>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-condition">{{localize "AOE.FIELD_CONDITION"}}</label>
    <select id="aoe-free-condition">
      {{selectOptions conditionOptions valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-duration">{{localize "AOE.FIELD_DURATION"}}</label>
    <input id="aoe-free-duration" type="number" min="0" value="0"/>
  </div>
  {{!-- v2.3 (Rudolfs Testrunde 3, Punkte 3+4): „Auslösen“ - Beim Betreten
      hängt die freie Zone ans Token-Betreten-Verhalten (aoeZoneEnter führt
      die VOLLLE Auslösung aus, konsistent mit Kraft-Zonen und
      Anfangsbestand), die Voreinstellung bleibt die reine Auslöse-Taste. --}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="aoe-free-trigger">{{localize "AOE.FIELD_TRIGGER"}}</label>
    <select id="aoe-free-trigger">
      <option value="">{{localize "AOE.TRIGGER_MANUAL"}}</option>
      <option value="enter">{{localize "AOE.TRIGGER_ENTER"}}</option>
    </select>
  </div>
</div>
