<div class="symbaroum dialog">
  {{#if askWeapon}}
  <div class="attribute">
    <label>{{localize "DIALOG.CHOOSE_WEAPON"}}</label>
    <select id="weapon">
        {{#each weapons}}
        <option value={{this.id}}>{{this.name}} | {{this.system.attribute}} </option>
        {{/each}}
    </select>
  </div>
  {{/if}}
  {{#if isWeaponRoll}}
    <div class="simplebox freeattack-row">
      <label>{{localize "DIALOG.FREE_ATTACK"}}</label><span class="lblfavour"><input type="checkbox" id="freeattack" unchecked></span>
    </div>
  {{/if}}
  {{#if askCastingAttribute}}
  <div class="attribute">
      <label>{{localize "DIALOG.CASTING_ATTRIBUTE"}}</label>
      <select id="castAt">
        <option value="accurate">{{localize "ATTRIBUTE.ACCURATE"}}</option>
        <option value="cunning">{{localize "ATTRIBUTE.CUNNING"}}</option>
        <option value="discreet">{{localize "ATTRIBUTE.DISCREET"}}</option>
        <option value="persuasive">{{localize "ATTRIBUTE.PERSUASIVE"}}</option>
        <option value="quick">{{localize "ATTRIBUTE.QUICK"}}</option>
        <option value="resolute" selected>{{localize "ATTRIBUTE.RESOLUTE"}}</option>
        <option value="strong">{{localize "ATTRIBUTE.STRONG"}}</option>
        <option value="vigilant">{{localize "ATTRIBUTE.VIGILANT"}}</option>
        <option value="defense">{{localize "ARMOR.DEFENSE"}}</option>
    </select>
  </div>
  {{/if}}
	{{#if askTargetAttribute}}
    <div class="attribute">
        <label>{{localize "DIALOG.RESIST_ATTRIBUTE"}}</label>
        <select id="resistAtt">
            <option value="accurate">{{localize "ATTRIBUTE.ACCURATE"}}</option>
            <option value="cunning">{{localize "ATTRIBUTE.CUNNING"}}</option>
            <option value="discreet">{{localize "ATTRIBUTE.DISCREET"}}</option>
            <option value="persuasive">{{localize "ATTRIBUTE.PERSUASIVE"}}</option>
            <option value="quick">{{localize "ATTRIBUTE.QUICK"}}</option>
            <option value="resolute" selected>{{localize "ATTRIBUTE.RESOLUTE"}}</option>
            <option value="strong">{{localize "ATTRIBUTE.STRONG"}}</option>
            <option value="vigilant">{{localize "ATTRIBUTE.VIGILANT"}}</option>
            <option value="defense">{{localize "ARMOR.DEFENSE"}}</option>
        </select>
    </div>
  {{/if}}
  {{#if hasRoll}}
  <div class="bonus">
    <label>{{localize "DIALOG.MODIFIER"}}</label>
    <input id="bonus" type="number" value="{{defaultModifier}}" data-dtype="Number"/>
  </div>
  {{!-- S4 „Tag/Reise/Ressourcen" (07.11.2026): Hinweiszeile über dem
       Gunst-Radio bei Hunger/Durst — Fähigkeitswurf (item.js liefert
       travelFavourHint + travelDefaultFavour als Radio-Vorbelegung) --}}
  {{#if travelFavourHint}}<div class="favour travel-favour-hint"><label class="lblfavour">{{travelFavourHint}}</label></div>{{/if}}
  <div class="favour">
    <label class="lblfavour">{{radioBoxes groupName choices checked=defaultFavour localize=true}}</label>
  </div>
  {{!-- Segen & Lasten S2 (Rudolfs „Leg los“, 06.11.2026): Kontext-Zeilen
       der besessenen Segen/Lasten für die Wurf-Eigenschaft — nur bei
       Besitz, leer + ankreuzbar (Impeding-Muster); Bonus-Zeilen
       addieren auf den Modifikator, B/G-Zeilen setzen + sperren das
       Gunst-Radio (item.js-Submit nach dem Gunst-Radio). --}}
  {{#each boon_lines as |line|}}
  <div class="simplebox boon-line-row">
    <label for="boonline-{{line.key}}">{{line.label}}</label>
    <span class="lblfavour"><input type="checkbox" id="boonline-{{line.key}}" data-boonline="{{line.key}}" data-sc="{{line.sc}}" unchecked></span>
  </div>
  {{/each}}
  {{/if}}
  {{#if askImpeding}}
  <div class="simplebox">
    <label>{{localize "DIALOG.IMPEDING"}}</label> <span class="lblfavour"><input type="checkbox" id="impeding" checked></span>
  </div>
  {{/if}}
  {{#if targetImpeding}}
  <div class="simplebox">
    <label>{{localize "ARMOR.IMPEDING_TARGET"}}</label> <span class="lblfavour"><input type="checkbox" id="impTarget" checked></span>
  </div>
  {{/if}}
  {{#if askCorruptedTargetDefaultNo}}
  <div class="simplebox">
    <label>{{localize "DIALOG.ASK_CORRUPTION"}}</label><span class="lblfavour"><input type="checkbox" id="targetCorrupt" unchecked></span>
  </div>
  {{/if}}
  {{#if askCorruptedTargetDefaultYes}}
  <div class="simplebox">
    <label>{{localize "DIALOG.ASK_CORRUPTION"}}</label><span class="lblfavour"><input type="checkbox" id="targetCorrupt" checked></span>
  </div>
  {{/if}}
  {{#if isWeaponRoll}}
    {{#if precise}}
      <div class="damagemodifier">
        <label for="precise">{{localize "COMBAT.PARAMS_PRECISE"}}</label> <div class="weapondamage"><span id="weapondamage">{{localize "COMBAT.CHAT_MODIFIER"}}1</span></div>
      </div>
    {{/if}}
    <div class="damagemodifier">
      <label for="weapondamage">{{localize "WEAPON.BASE_DAMAGE"}}</label> <div class="weapondamage"><span id="weapondamage">{{weaponDamage}}</span></div>
    </div>
    {{#if ignoreArmor}}
      <div class="simplebox">
        <label>{{localize "DIALOG.IGNORE_ARMOR"}}</label><span class="lblfavour"><input type="checkbox" id="ignarm" checked></span>
      </div>
    {{else}}
    <div class="simplebox">
      <label>{{localize "DIALOG.IGNORE_ARMOR"}}</label><span class="lblfavour"><input type="checkbox" id="ignarm" unchecked></span>
    </div>
    {{/if}}
    {{!-- Elixiere v1.7 (Rudolfs Waffengift-Dialog-Vereinheitlichung): die
         alte Grad-Zeile "Gift aufgetragen?" entfällt - DIE Gift-Zeile ist
         "Gift auftragen": Inventar-Gifte (1 Dosis je Angriff, Abbuchung
         beim Würfeln) PLUS unbegrenzte Eigengift-Option für Vergifter/
         Giftig (Grad aus der Merkmalsstufe, vorselektiert, kein Verbrauch).
         Nur mit Bestand im Inventar oder Vergifter/Giftig-Merkmal. --}}
    {{#if askPoisonCoating}}
    <div class="bonus">
      <label title="{{localize "DIALOG.POISON_COATING_HINT"}}">{{localize "DIALOG.POISON_COATING"}}</label>
      <select id="poisonCoating">
        <option value="none" {{#unless ownPoison}}{{#unless activeCoat}}{{#unless pendingCoat}}selected{{/unless}}{{/unless}}{{/unless}}>{{localize "DIALOG.POISON_COATING_NONE"}}</option>
        {{#if ownPoison}}<option value="ownpoison" selected>{{ownPoison.label}}</option>{{/if}}
        {{#if activeCoat}}<option value="activecoat" selected>{{localize "POISON.COAT_OPTION" grade=activeCoat.grade}}</option>{{/if}}
        {{#if pendingCoat}}<option value="dosecoat" selected>{{localize "POISON.PENDING_COAT_OPTION" name=pendingCoat.name}}</option>{{/if}}
        {{#each poisonCoatingChoices as |choice|}}
        <option value="{{choice.id}}">{{choice.name}} ({{localize "EQUIPMENT.QUANTITY_SHORT"}} {{choice.count}})</option>
        {{/each}}
      </select>
    </div>
    {{/if}}
    {{#if askBackstab}}
    <div class="simplebox">
      <label>{{localize "DIALOG.BACKSTAB"}}</label> <span class="lblfavour"><input type="checkbox" id="usebackstab" unchecked></span>
    </div>
    {{/if}}
  {{/if}}
  {{#if contextualDamage}}
    <div class="simplebox">
      <label>{{localize "DIALOG.ADVANTAGE"}}</label><span class="lblfavour"><input type="checkbox" id="advantage" unchecked></span>
    </div>
    {{#each packages as |package|}}
      {{#ife package.type "radio"}}
        <div class="favour"><label class="lblfavour">{{radioBoxes package.id package.radioAlternatives checked=package.defaultSelect localize=false}}</label></div>
      {{/ife}}
      {{#ife package.type "checkbox"}}
        <div class="advantage freeattack-suppress"><label for="{{package.id}}">{{package.label}}</label><div class="packageInfo"><input class="checkbox" type="checkbox" id="{{package.id}}" value="{{package.value}}" data-dtype="Text" ><input for="{{package.id}}" class="packageDetail" type="text" value="{{package.value}}" data-dtype="Text" disabled/></div></div>
      {{/ife}}
    {{/each}}
    {{#if leaderTarget}}
    <div class="damagemodifier">
      <label for="weapondamage">{{localize "COMBAT.CHAT_DMG_PARAMS_LEADER"}}</label> <div class="weapondamage"><span id="weapondamage">{{d4}}</span></div>
    </div>
    {{/if}}
    {{!-- Segen & Lasten S2.1 (P4 Feuer-Paket, Rudolfs Freigabe 06.11.2026):
         Elementarrune NUR im Stabgeschoss-Dialog (RAW Stabmagie-Novize:
         freie Aktion, +1W4 Stabschaden). Rune Feuer markiert den Schaden
         als Feuer (Feuergeschmiedet-Schutz des Ziels greift, Kontextzeile
         des Anwenders erscheint). --}}
    {{#if isStaffProjectile}}
    <div class="simplebox">
      <label for="elementalrune">{{localize "POWER_STAFFPROJECTILE.ELEMENTAL_RUNE"}}</label>
      <select id="elementalrune" data-tooltip="{{localize "POWER_STAFFPROJECTILE.ELEMENTAL_RUNE_TOOLTIP"}}">
        <option value="none">{{localize "POWER_STAFFPROJECTILE.ELEMENTAL_RUNE_NONE"}}</option>
        <option value="fire">{{localize "POWER_STAFFPROJECTILE.ELEMENTAL_RUNE_FIRE"}}</option>
        <option value="lightning">{{localize "POWER_STAFFPROJECTILE.ELEMENTAL_RUNE_LIGHTNING"}}</option>
        <option value="cold">{{localize "POWER_STAFFPROJECTILE.ELEMENTAL_RUNE_COLD"}}</option>
        <option value="acid">{{localize "POWER_STAFFPROJECTILE.ELEMENTAL_RUNE_ACID"}}</option>
      </select>
    </div>
    {{/if}}
    <div class="damagemodifier">
      <label>{{localize "DIALOG.DAMAGE_MODIFIER"}}</label><input id="dammodifier" value="{{defaultDamModifier}}" type="text" data-dtype="Text"/>
    </div>
  {{/if}}
  {{#if isArmorRoll}}
  <div class="advantage">
    <label>{{localize "DIALOG.DISADVANTAGE"}}</label> <span class="lblfavour"><input type="checkbox" {{defaultAdvantage}} id="advantage" value="1" data-dtype="Number"> </span>
  </div>
  {{/if}}
  {{#if checkMaintain}}
  <div class="maintain">
    <label class="lblfavour">{{radioBoxes "maintain" maintainChoices checked=defaultMaintain localize=true}}</label>
  </div>
  {{/if}}
  {{#if medicus}}
    {{#if hasTarget}}
      <div class="simplebox">
        <label>{{localize "DIALOG.MEDICUS_EXAM"}}</label><span class="lblfavour"><input type="checkbox" id="exam" unchecked></span>
      </div>
      {{!-- Ressourcen v1 (Rudolfs Entscheidung 2): Fehlt Kraeuterarznei im
          Inventar (Kategorie kraeuterarznei), ist die Checkbox ausgegraut
          und traegt einen Tooltip - nur wenn das Welt-Setting
          „Ressourcenverbrauch" aktiv ist, sonst unangetastet. --}}
      <div class="simplebox">
        <label>{{localize "ABILITY_MEDICUS.HERBALCURE"}}</label><span class="lblfavour"><input type="checkbox" id="herbalcure" unchecked {{#if herbalCureUnavailable}}class="herbalcure-empty" disabled data-tooltip="{{localize "ABILITY_MEDICUS.HERBALCURE_MISSING"}}{{/if}}></span>
      </div>
      {{!-- Ressourcen v1.3 (Bandagen-Runde, 31.10.): Automatische Verbands-
          material-Statuszeile - KEINE Checkbox, der Spieler waehlt nichts
          (Rudolfs Festlegung). Vorhanden: Check-Glyph, 1 Einheit wird beim
          Wurf abgebucht; fehlt: X-Glyph + „−1"-Badge, der Wurf erhaelt
          automatisch −1. Nur wenn das Welt-Setting aktiv ist
          (bandageStatus), sonst bleibt der Dialog unangetastet. --}}
      {{#if bandageStatus}}
      <div class="simplebox bandage-status">
        <label>{{localize "ABILITY_MEDICUS.BANDAGE"}}</label>
        <span class="lblfavour bandage-indicator">
          {{#if bandageAvailable}}
          <span class="bandage-ok"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          {{else}}
          <span class="bandage-missing" data-tooltip="{{localize "ABILITY_MEDICUS.BANDAGE_MISSING"}}"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span><span class="bandage-penalty" data-tooltip="{{localize "ABILITY_MEDICUS.BANDAGE_MISSING"}}">−1</span>
          {{/if}}
        </span>
      </div>
      {{/if}}
      <div class="damagemodifier">
        <label>{{localize "DIALOG.CUSTOM_HEALING_MODIFIER"}}</label><input id="customhealing" value="" type="text" data-dtype="Text"/>
      </div>
      {{else}}
      <h4>{{localize "ABILITY_MEDICUS.NO_TARGET"}}</h4>
    {{/if}}
  {{/if}}
  {{#if poisoner}}
  <div class="bonus">
    <label>{{localize "DIALOG.USE_POISON"}}</label>
    <select id="poisoner">
      {{#each poisonerChoices}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
  </select>
  </div>
  {{/if}}
  {{!-- Gift v1.2 (Rudolfs v1.1-Runde, P11): FESTE Handbuch-Bonus-Zeile
        (Muster Waffenqualität "Durchschlagend": Label + gesperrtes Feld);
        der Submit wendet das +1 auf den Giftmischer-Wurf an. --}}
  {{#if poisonManualBonus}}
  <div class="bonus">
    <label title="{{localize "DIALOG.POISON_MANUAL_HINT"}}">{{localize "DIALOG.POISON_MANUAL_LABEL"}}</label>
    <input type="text" value="+1" data-dtype="Text" disabled/>
  </div>
  {{/if}}
</div>