<div class="symbaroum chat ability">
    <div class="foreground">
        <div class="introImg" style="background-image: url('{{introImg}}')">
            <div class="introTxt">{{removeMarkup introText}}</div>
            {{#if hasTarget}}
            <div class="introImg" style="background-image: url('{{targetData.actor.img}}')"></div>            
            <div class="targetText">{{removeMarkup targetText}}</div>
            {{/if}}
        </div>
        <div class="subText">{{removeMarkup subText}}</div>            
        <img src="{{subImg}}"/>
        {{#if hasRoll}}
        <div class="finalTxt">
            {{#if resistRoll}}
            <p>{{resistRollText}}</p>
            {{/if}}
        <p data-item-id="{{id}}">{{rollString}}</p>
    </div>
        <div class="finalTxt">
            <div class="tooltip">
                <p>{{removeMarkup rollResult}}</p>
                <span class="tooltiptext">{{rollToolTip}}</span>
            </div>
        </div>
        {{!-- S3 (/rig-Erweiterung): Hinweiszeile bei erzwungenem
             Würfelergebnis auf Angriffs-/Fähigkeitskarten; rigged ist
             bei normalen Würfen 0/undefined und die Zeile entfällt. --}}
        {{#if rigged}}
        <div class="finalTxt"><p>{{localize "RIG.CHAT_LINE" value=rigged}}</p></div>
        {{/if}}
        {{/if}}
        <div class="finalTxt">
            <p>{{resultText}}</p>
            <p>{{finalText}}</p>
            {{#if hasDamage}}
            <div class="finalTxt">{{removeMarkup dmgFormula}}
            </div>
            <div class="finalTxt">
                <div class="tooltip">
                    <p>{{{damageText}}}</p>
                    <span class="tooltiptext">{{{damageTooltip}}}</span>
                </div>
            </div>
            <div class="finalTxt">
                <p>{{removeMarkup damageFinalText}}</p>
            </div>
            {{/if}}
        {{#if haveCorruption}}
        <p>{{removeMarkup corruptionText}}</p>
        {{/if}}
        </div>
    </div>
</div>