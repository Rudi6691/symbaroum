<div class="symbaroum dialog">
	{{#if askTargetAttribute}}
    <div class="attribute">
        <label for="targetAttribute-{{did}}">{{localize "DIALOG.VERSUS"}}</label>
        <select id="targetAttribute-{{did}}">
          {{selectOptions targetAttribute_selection selected=roll_defaults.targetAttributeName labelAttr="label"}}
        </select>
    </div>
  {{/if}}
  <div class="bonus">
    <label for="modifier-{{did}}">{{localize "DIALOG.MODIFIER"}}</label>
    <input id="modifier-{{did}}" type="number" value="{{roll_defaults.modifier}}" data-dtype="Number"/>
  </div>
  {{!-- S4 v1.2 (Rudolfs Testrunde 2): Hunger-Stärke-Malus UNVERÄNDERBAR —
        gesperrte Kontextzeile (Muster Gift-Handbuch-Bonus); der Abzug
        wirkt fix beim Submit (dialog.js), KEIN editierbares Feld mehr. --}}
  {{#if travelStrengthPenalty}}
  <div class="bonus">
    <label title="{{localize "TRAVEL.STRENGTH_AUTOPARAM_HINT"}}">{{localize "TRAVEL.STRENGTH_AUTOPARAM_LABEL"}}</label>
    <input type="text" value="-{{travelStrengthPenalty}}" data-dtype="Text" disabled/>
  </div>
  {{/if}}
  {{#if isWeaponRoll}}
    <div class="simplebox freeattack-row">
      <label for="freeattack-{{did}}">{{localize "DIALOG.FREE_ATTACK"}}</label><span class="lblfavour"><input type="checkbox" id="freeattack-{{did}}" unchecked></span>
    </div>
    {{#each weaponModifiers.package as |package|}}
      {{#ife package.type "default"}}
        {{#ifgt package.member.length 0}}
          {{#each package.member as |member|}}
            {{#ife member.type "attackrollmod"}}
              <div class="bonus{{#if member.a30GripSuppress}} a30-grip-suppress{{/if}}">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.modifier}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
          {{/each}}    
        {{/ifgt}}
      {{/ife}}
    {{/each}}
  {{/if}}
  {{!-- S4 „Tag/Reise/Ressourcen" (07.11.2026): Hinweiszeile über dem
       Gunst-Radio bei Hunger/Durst (Muster dialog-deathtest.hbs);
       das Radio selbst ist unten VORBELEGT, nicht verriegelt --}}
  {{#if travelFavourHint}}<div class="favour travel-favour-hint"><label class="lblfavour">{{travelFavourHint}}</label></div>{{/if}}
  <div class="favour">
    <label class="lblfavour">{{radioBoxes groupName choices checked=roll_defaults.selectedFavour localize=true}}</label>
  </div>
  {{!-- Segen & Lasten S2 (Rudolfs „Leg los“, 06.11.2026): Kontext-Zeilen
       der besessenen Segen/Lasten für diese Eigenschaft — nur bei Besitz,
       leer + ankreuzbar (Impeding-Muster); Bonus-Zeilen addieren auf den
       Modifikator, B/G-Zeilen setzen + sperren das Gunst-Radio
       (dialog.js-Submit nach dem Gunst-Radio; activateBoonLineExclusive
       für die Exklusivität am Live-DOM). --}}
  {{#each boon_lines as |line|}}
  <div class="simplebox boon-line-row">
    <label for="boonline-{{../did}}-{{line.key}}">{{line.label}}</label>
    <span class="lblfavour"><input type="checkbox" id="boonline-{{../did}}-{{line.key}}" data-boonline="{{line.key}}" data-sc="{{line.sc}}" unchecked></span>
  </div>
  {{/each}}

  {{#if askImpeding}}
  <div class="simplebox">
    <label for="impeding-{{did}}" style="width: 90%;">{{localize "DIALOG.IMPEDING"}}</label> <span class="lblfavour" style="width: 40%;"><input type="checkbox" id="impeding-{{did}}" {{roll_defaults.impeding}}></span>
  </div>
  {{/if}}
  {{#if askCorruptedTarget}}
  <div class="simplebox">
    <label for="targetCorrupt-{{did}}">{{localize "DIALOG.ASK_CORRUPTION"}}</label><span class="lblfavour"><input type="checkbox" id="targetCorrupt-{{did}}" unchecked></span>
  </div>
  {{/if}}
  {{#if isWeaponRoll}}
    <div class="advantage">
      <label for="advantage-{{did}}">{{localize "DIALOG.ADVANTAGE"}}</label> <span class="lblfavour"><input type="checkbox" {{roll_defaults.advantage}} id="advantage-{{did}}" value="1" data-dtype="Number"> </span>
    </div>
    <div class="damagemodifier">
      <label for="weapondamage-{{did}}">{{localize "DIALOG.WEAPON_DAMAGE"}}</label><input id="weapondamage-{{did}}" disabled type="text" value="{{weaponDamage}}" data-dtype="Text"/>
    </div>
    {{#if askBastardGrip}}
      <div class="favour a30-grip">
        <label class="lblfavour">{{radioBoxes "bripType" gripChoices checked=defaultGrip localize=true}}</label>
      </div>
    {{/if}}
    {{#if askIgnoreArmor}}
      {{#if ignoreArm}}
        <div class="simplebox">
          <label for="ignarm-{{did}}">{{localize "DIALOG.IGNORE_ARMOR"}}</label><span class="lblfavour"><input type="checkbox" id="ignarm-{{did}}" checked></span>
        </div>
        {{else}}
        <div class="simplebox">
          <label for="ignarm-{{did}}">{{localize "DIALOG.IGNORE_ARMOR"}}</label><span class="lblfavour"><input type="checkbox" id="ignarm-{{did}}" unchecked></span>
        </div>
        {{/if}}
    {{/if}}
    {{#each weaponModifiers.package as |package|}}
      {{#ife package.type "default"}}
        {{#ifgt package.member.length 0}}
          {{#each package.member as |member|}}
            {{#ife member.type "damagemodifier"}}
              <div class="damagemodifier{{#if member.a30GripSuppress}} a30-grip-suppress{{/if}}"><label for="dm-{{../did}}-{{member.id}}-fixedmodifier">{{member.label}}</label><input id="dm-{{../did}}-{{member.id}}-fixedmodifier" disabled type="text" value="{{member.value}}" data-dtype="Text"/></div>
            {{/ife}}
            {{#ife member.type "statusDoT"}}
              <div class="bonus{{#if member.a30GripSuppress}} a30-grip-suppress{{/if}}">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.value}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
            {{#ife member.type "corruptingattack"}}
              <div class="bonus{{#if member.a30GripSuppress}} a30-grip-suppress{{/if}}">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.value}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
          {{/each}}
        {{/ifgt}}
      {{/ife}}
      {{#ife package.type "radio"}}
        <div class="favour"><label class="lblfavour">{{radioBoxes package.id package.radioAlternatives checked=package.defaultSelect localize=false}}</label></div>
      {{/ife}}
      {{#ife package.type "checkbox"}}
        <div class="advantage freeattack-suppress"><label for="pgkid-{{../did}}-{{package.id}}">{{package.label}}</label><div class="packageInfo"><input class="checkbox" type="checkbox" id="pgkid-{{../did}}-{{package.id}}" value="{{package.value}}" data-dtype="Text" ><input for="pgkid-{{../did}}-{{package.id}}" class="packageDetail" type="text" value="{{package.value}}" data-dtype="Text" disabled/></div></div>
      {{/ife}}
    {{/each}}
    {{!-- Axtkünstler v1.1 (Rudolfs Testrunde 1): Technik-Auswahl im
         Würfeldialog des Waffenangriffs - klassische Variante als schlichte
         Radio-Zeile (der Rahmen-Umbau ist nur fürs moderne Design) --}}
    {{#if askAxeArtist}}
      <div class="favour">
        <label class="lblfavour">{{localize "ABILITY_LABEL.AXE_ARTIST"}}:</label>
        {{#each axeArtistChoices as |choice|}}
        <label class="lblfavour" title="{{choice.hint}}"><input type="radio" name="axeArtistTechnique" value="{{choice.value}}" {{#if choice.checked}}checked{{/if}}> {{choice.label}}</label>
        {{/each}}
      </div>
    {{/if}}
    {{!-- Dreckiger Kampf v1 (Rudolfs Auswahlrunde 29.10.): klassische
         Radio-Zeile, Muster Axtkünstler --}}
    {{#if askCheapshot}}
      <div class="favour">
        <label class="lblfavour">{{localize "ABILITY_LABEL.CHEAP_SHOT"}}:</label>
        {{#each cheapshotChoices as |choice|}}
        <label class="lblfavour" title="{{choice.hint}}"><input type="radio" name="cheapshotTechnique" value="{{choice.value}}" {{#if choice.checked}}checked{{/if}}> {{choice.label}}</label>
        {{/each}}
      </div>
    {{/if}}
    {{!-- Elixiere v1.4 (Rudolfs Freigabe 02.11.): Spezialmunition-Opt-in
         (Betäubungspfeil/Treffpfeil) - klassische Radio-Zeile, Muster
         Axtkünstler/Dreckiger Kampf; nur EINE Wirkung wählbar, Abbuchen
         beim Würfeln (ammo.js), Wirkung feuert im Kampfautomatik-Pfad --}}
    {{#if askAmmoEffect}}
      <div class="favour">
        <label class="lblfavour">{{localize "DIALOG.AMMO_EFFECT_OPTIN"}}:</label>
        {{#each ammoEffectChoices as |choice|}}
        <label class="lblfavour" title="{{choice.hint}}"><input type="radio" name="ammoEffectChoice" value="{{choice.value}}" {{#if choice.checked}}checked{{/if}}> {{choice.label}}</label>
        {{/each}}
      </div>
    {{/if}}
    {{!-- Elixiere v1.5 (Rudolfs Freigabe 02.11.): Gift-Beschichtung aus dem
         Inventar (Select, Muster Giffter-Dosiszeile) - nur mit Dosis-Stapel
         im Bestand; 1 Dosis je Angriff wird beim Würfeln abgebucht, die
         [Stärke gegen Stärke]-Probe feuert bei Treffer auf der Karte --}}
    {{!-- Elixiere v1.5 (Rudolfs Freigabe 02.11.): Gift-Beschichtung aus dem
         Inventar (Select, Muster Giffter-Dosiszeile) - nur mit Dosis-Stapel
         im Bestand; 1 Dosis je Angriff wird beim Würfeln abgebucht, die
         [Stärke gegen Stärke]-Probe feuert bei Treffer auf der Karte.
         Elixiere v1.7 (Waffengift-Dialog-Vereinheitlichung): DIE Gift-Zeile
         des Waffen-Dialogs - zusätzlich zum Inventar die unbegrenzte
         EIGENGIFT-Option für Vergifter/Giftig (Grad aus der Merkmalsstufe,
         vorselektiert); die alte Grad-Zeile "Gift aufgetragen?" entfällt. --}}
    {{#if askPoisonCoating}}
      <div class="bonus">
        <label title="{{localize "DIALOG.POISON_COATING_HINT"}}">{{localize "DIALOG.POISON_COATING"}}</label>
        <select id="poisonCoating-{{did}}">
          <option value="none" {{#unless ownPoison}}{{#unless activeCoat}}{{#unless pendingCoat}}selected{{/unless}}{{/unless}}{{/unless}}>{{localize "DIALOG.POISON_COATING_NONE"}}</option>
          {{#if ownPoison}}<option value="ownpoison" selected>{{ownPoison.label}}</option>{{/if}}
          {{#if activeCoat}}<option value="activecoat" selected>{{localize "POISON.COAT_OPTION" grade=activeCoat.grade}}</option>{{/if}}
          {{#if pendingCoat}}<option value="dosecoat" selected>{{localize "POISON.PENDING_COAT_OPTION" name=pendingCoat.name}}</option>{{/if}}
          {{#each poisonCoatingChoices as |choice|}}
          <option value="{{choice.id}}">{{choice.name}} ({{localize "EQUIPMENT.QUANTITY_SHORT"}} {{choice.count}})</option>
          {{/each}}
        </select>
      </div>
    {{/if}}
    {{!-- Gift v1.2 (Rudolfs v1.1-Runde, P11): FESTE Handbuch-Bonus-Zeile
          (Muster Waffenqualität "Durchschlagend": Label + gesperrtes Feld)
          - das +1 wirkt auf die Gift-/Beschichtungsprobe, nicht auf den
          Angriffswurf (siehe Hint-Tooltip). --}}
    {{#if poisonManualBonus}}
      <div class="bonus">
        <label title="{{localize "DIALOG.POISON_MANUAL_HINT"}}">{{localize "DIALOG.POISON_MANUAL_LABEL"}}</label>
        <input type="text" value="+1" data-dtype="Text" disabled/>
      </div>
    {{/if}}
      <div class="damagemodifier">
        <label for="dammodifier-{{did}}">{{localize "DIALOG.DAMAGE_MODIFIER"}}</label> <input id="dammodifier-{{did}}" value="{{roll_defaults.additionalModifier}}" type="text" data-dtype="Text"/> 
      </div>
      {{#if askAttackNb}}
        <div class="favour"><label class="lblfavour">{{radioBoxes attNbRadio weaponModifiers.radioAttacks localize=false}}</label></div>
      {{/if}}
    {{/if}}
    {{#if isArmorRoll}}
    <div class="advantage">
      <label for="advantage-{{did}}">{{localize "DIALOG.DISADVANTAGE"}}</label> <span class="lblfavour"><input id="advantage-{{did}}" type="checkbox" {{roll_defaults.advantage}} id="advantage" value="1" data-dtype="Number"> </span>
    </div>
    {{/if}}    		

</div>