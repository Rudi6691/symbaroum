{{!-- Brauen v1 (Rudolfs Freigabe 02.11.): Brau-Dialog am Alchemie-Fähigkeits-
    Item. Elixier-Auswahl (Kandidaten je Modus: Ökonomie = eigene Rezepturen,
    RAW = Welt-Items), Labor-Dropdown (P9: alle Labore des Charakters,
    absteigend nach Bonus, bestes vorausgewählt), Dosen-Hinweis (RAW-Tabelle)
    und im Ökonomie-Modus die Zutaten-Zeilen (je Dosis + Bestand); Radios
    „Öffentlich“/„Geheim“ wie der Geben-Dialog (Geheim => Flüster-Karte).
    Muster: elixir-throw.hbs (renderTemplate mit vollem Pfad, kein Partial,
    theme-adaptive Zweige über renderModern).
    v1.7 (Rudolfs Testrunde v1.6, Freigabe 04.11.): Ein-/Ausgabefelder
    25 % breiter bei UNVERÄNDERTER Dialogbreite — klassische Labels
    schrumpfen auf Textbreite (Felder füllen den freigewordenen Platz),
    moderner Feld-Deckel 9rem → 11.25rem (+25 % exakt), gescoped über
    die Root-Klasse symb-alch. Keine Info-Zeile in diesem Dialog — nur
    Feld-Verbreiterung, brewing.js unberührt. --}}
{{!-- Brauen v1.2 (Testrunde 2, P8-Labels): Das Wurzelelement trägt die
    Klasse "dialog" NUR noch im klassischen Modus - im modernen Modus ist
    der Root "symbaroum modern-roll-dialog" wie der kanonische moderne
    Würfeldialog (dialog-modern.hbs) und der Geben-Dialog. Die Klasse
    "dialog" zog sonst die klassische Texturbanner-Regel für Labels
    (!important) auch in den modernen Dialog. --}}
<div class="symbaroum symb-alch{{#if renderModern}} modern-roll-dialog{{else}} dialog{{/if}}">
  {{!-- v1.7: Felder 25 % breiter — gescoped über .symb-alch (nur die
      Alchemie-Dialoge tragen die Klasse, andere Systemdialoge unberührt;
      kein !important im System-CSS auf den überschriebenen Regeln). --}}
  <style>
    .symbaroum.dialog.symb-alch .attribute > label { width:auto; min-width:0; flex:0 0 auto; }
    .symbaroum.modern-roll-dialog.symb-alch .m-roll-row input[type=number],
    .symbaroum.modern-roll-dialog.symb-alch .m-roll-row input[type=text],
    .symbaroum.modern-roll-dialog.symb-alch .m-roll-row select { flex:0 0 11.25rem; width:11.25rem; box-sizing:border-box; }
  </style>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="brew-elixir">{{localize "BREW.SELECT_ELIXIR"}}</label>
    <select id="brew-elixir">
      {{selectOptions candidates selected=preselect valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="brew-lab">{{localize "BREW.LAB"}}</label>
    <select id="brew-lab" data-tooltip="{{localize "BREW.LAB_TOOLTIP"}}">
      {{selectOptions facilities selected=labId valueAttr="id" labelAttr="label"}}
    </select>
  </div>
  {{!-- Sammel-Fix v1.1 (Rudolfs Testrunde 1, Punkt 10): freies Modifikator-
      Feld zwischen Labor und Dosen — landet in baseRoll zusätzlich zum
      Labor-Bonus (z. B. Situationsboni/-mali); leer/ungültig = 0. --}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="brew-modifier">{{localize "DIALOG.MODIFIER"}}</label>
    <input id="brew-modifier" type="number" value="0"/>
  </div>
  {{!-- Sammel-Fix v1.3 (Rudolfs Testrunde v1.2, Punkt 6c): Gunst-Block
      (Normal/Gunst/Missgunst) wie der kanonische Würfeldialog HINTER dem
      Modifikator — Gunst = 2d20kl (bester), Missgunst = 2d20kh (schlecht-
      ester), Normal = 1d20; brewing.js reicht favour an baseRoll durch. --}}
  {{#if renderModern}}
  <fieldset class="m-ability-frame">
    <legend class="m-ability-label">{{localize "DIALOG.FAVOUR_LEGEND"}}</legend>
    <div class="m-give-vis">
      <label class="lblfavour">
        <input type="radio" name="brew-favour" value="0" checked/>
        {{localize "DIALOG.FAVOUR_NORMAL"}}
      </label>
      <label class="lblfavour">
        <input type="radio" name="brew-favour" value="1"/>
        {{localize "DIALOG.FAVOUR_FAVOUR"}}
      </label>
      <label class="lblfavour">
        <input type="radio" name="brew-favour" value="-1"/>
        {{localize "DIALOG.FAVOUR_DISFAVOUR"}}
      </label>
    </div>
  </fieldset>
  {{else}}
  <div class="favour">
    <label class="lblfavour">
      <input type="radio" name="brew-favour" value="0" checked/>
      {{localize "DIALOG.FAVOUR_NORMAL"}}
    </label>
    <label class="lblfavour">
      <input type="radio" name="brew-favour" value="1"/>
      {{localize "DIALOG.FAVOUR_FAVOUR"}}
    </label>
    <label class="lblfavour">
      <input type="radio" name="brew-favour" value="-1"/>
      {{localize "DIALOG.FAVOUR_DISFAVOUR"}}
    </label>
  </div>
  {{/if}}
  {{!-- Segen & Lasten S2 Baustein A (Rudolfs „Leg los“, 06.11.2026):
      Grüner-Daumen-Zeile — nur bei Besitz des Segens (greenthumb null
      sonst). Bonus = bonusValue (Fallback +1), addiert sich opt-in per
      Häkchen auf die Brau-Probe. --}}  {{#if greenthumb}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="brew-greenthumb" data-tooltip="{{localize "BOON.LINE_GREENTHUMB_TOOLTIP"}}">{{greenthumb.label}}</label>
    <input id="brew-greenthumb" type="checkbox"/>
  </div>
  {{/if}}
  {{!-- Alchemie Modul 3: Nachbrau-Bonus-Häkchen (nur sichtbar, wenn der
      Actor-Flag 'nachbrauBonus' aktiv ist - brewing.js verbraucht den Flag
      beim nächsten Gebräu mit +1). Standard: angehakt. --}}
  {{#if bonusNext}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label for="brew-bonus-next" data-tooltip="{{localize "BREW.BONUS_NEXT_TOOLTIP"}}">{{localize "BREW.BONUS_NEXT"}}</label>
    <input id="brew-bonus-next" type="checkbox" checked/>
  </div>
  {{/if}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label>{{localize "BREW.DOSES"}}</label>
    <input id="brew-dose-hint" type="text" disabled value="{{doseHint}}" data-tooltip="{{localize "BREW.DOSES_TOOLTIP"}}"/>
  </div>
  {{#if economy}}
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label>{{localize "BREW.MATERIALS"}}</label>
    <input id="brew-units" type="text" disabled value="{{unitsText}}" data-tooltip="{{localize "BREW.MATERIALS_TOOLTIP"}}"/>
  </div>
  <div class="{{#if renderModern}}m-roll-row{{else}}attribute{{/if}}">
    <label>{{localize "BREW.STOCK"}}</label>
    <input type="text" disabled value="{{stockText}}" data-tooltip="{{localize "BREW.STOCK_TOOLTIP"}}"/>
  </div>
  {{/if}}
  {{#if renderModern}}
  <fieldset class="m-ability-frame">
    <legend class="m-ability-label">{{localize "BREW.VISIBILITY"}}</legend>
    <div class="m-give-vis">
      <label class="lblfavour">
        <input type="radio" name="brew-vis" value="public" checked/>
        {{localize "GIVE.VISIBILITY_PUBLIC"}}
      </label>
      <label class="lblfavour">
        <input type="radio" name="brew-vis" value="secret"/>
        {{localize "GIVE.VISIBILITY_WHISPER"}}
      </label>
    </div>
  </fieldset>
  {{else}}
  <div class="favour">
    <label class="lblfavour">
      <input type="radio" name="brew-vis" value="public" checked/>
      {{localize "GIVE.VISIBILITY_PUBLIC"}}
    </label>
    <label class="lblfavour">
      <input type="radio" name="brew-vis" value="secret"/>
      {{localize "GIVE.VISIBILITY_WHISPER"}}
    </label>
  </div>
  {{/if}}
</div>
