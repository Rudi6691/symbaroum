{{!-- Automatisierungspaket 1 (Rudolf, 28.10.): moderne Variante des
    Würfeldialogs (Attribute/Blatt-Angriffe). Gleiche Feld-IDs und Namen wie
    das klassische dialog.hbs - die Callback-Logik in dialog.js liest per ID
    und bleibt unverändert. Das Fenster-Chrome themet der A6-Block
    (dialog.symb-dialog.modern-dialog); dieses Template liefert nur das
    Inhalts-Layout: Zeilen mit Label statt Textur-Banner (CSS-Block
    .symbaroum.modern-roll-dialog am Ende von symbaroum.css).
    v1.1 (28.10., Rudolfs Testrunde): Zeilenordnung Gunst -> Vorteil ->
    Freier Angriff; Waffenbereich neu geordnet (Effektwurf, Schadensmodifikator,
    Rüstung ignorieren, Waffenqualitäten, Fähigkeitsboni, bedingte Zeilen). --}}
<div class="symbaroum modern-roll-dialog">
  {{#if askTargetAttribute}}
  <div class="m-roll-row">
    <label for="targetAttribute-{{did}}">{{localize "DIALOG.VERSUS"}}</label>
    <select id="targetAttribute-{{did}}">
      {{selectOptions targetAttribute_selection selected=roll_defaults.targetAttributeName labelAttr="label"}}
    </select>
  </div>
  {{/if}}
  <div class="m-roll-row">
    <label for="modifier-{{did}}">{{localize "DIALOG.MODIFIER"}}</label>
    <input id="modifier-{{did}}" type="number" value="{{roll_defaults.modifier}}" data-dtype="Number"/>
  </div>
  <div class="m-roll-favour">
    <label class="lblfavour">{{radioBoxes groupName choices checked=roll_defaults.selectedFavour localize=true}}</label>
  </div>
  {{#if isWeaponRoll}}
    <div class="m-roll-check">
      <label for="advantage-{{did}}">{{localize "DIALOG.ADVANTAGE"}}</label>
      <input type="checkbox" {{roll_defaults.advantage}} id="advantage-{{did}}" value="1" data-dtype="Number">
    </div>
    <div class="m-roll-check freeattack-row">
      <label for="freeattack-{{did}}">{{localize "DIALOG.FREE_ATTACK"}}</label>
      <input type="checkbox" id="freeattack-{{did}}" unchecked>
    </div>
  {{/if}}
  {{#if askImpeding}}
  <div class="m-roll-check">
    <label for="impeding-{{did}}">{{localize "DIALOG.IMPEDING"}}</label>
    <input type="checkbox" id="impeding-{{did}}" {{roll_defaults.impeding}}>
  </div>
  {{/if}}
  {{#if askCorruptedTarget}}
  <div class="m-roll-check">
    <label for="targetCorrupt-{{did}}">{{localize "DIALOG.ASK_CORRUPTION"}}</label>
    <input type="checkbox" id="targetCorrupt-{{did}}" unchecked>
  </div>
  {{/if}}
  {{#if isWeaponRoll}}
    <div class="m-roll-sec">{{localize "WEAPON.HEADER"}}</div>
    <div class="m-roll-row">
      <label for="weapondamage-{{did}}">{{localize "DIALOG.WEAPON_DAMAGE"}}</label>
      <input id="weapondamage-{{did}}" disabled type="text" value="{{weaponDamage}}" data-dtype="Text"/>
    </div>
    <div class="m-roll-row">
      <label for="dammodifier-{{did}}">{{localize "DIALOG.DAMAGE_MODIFIER"}}</label>
      <input id="dammodifier-{{did}}" value="{{roll_defaults.additionalModifier}}" type="text" data-dtype="Text"/>
    </div>
    {{#if askIgnoreArmor}}
      <div class="m-roll-check">
        <label for="ignarm-{{did}}">{{localize "DIALOG.IGNORE_ARMOR"}}</label>
        <input type="checkbox" id="ignarm-{{did}}" {{#if ignoreArm}}checked{{else}}unchecked{{/if}}>
      </div>
    {{/if}}
    {{!-- Waffenqualitäten: feste Anzeige-Zeilen aus den Default-Paketen
         (Angriffs- und Schadensmodifikatoren, DoT-/Korruptions-Effekte).
         v1.2: NUR Mitglieder OHNE abilityMod-Flag (Fähigkeits-Mitglieder
         wie Eisenfaust-Adept +1d4 wandern zu den Fähigkeitsboni) --}}
    {{#each weaponModifiers.package as |package|}}
      {{#ife package.type "default"}}
        {{#ifgt package.member.length 0}}
          {{#each package.member as |member|}}
            {{#ifn member.abilityMod}}
            {{#ife member.type "attackrollmod"}}
              <div class="m-roll-row">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.modifier}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
            {{#ife member.type "damagemodifier"}}
              <div class="m-roll-row">
                <label for="dm-{{../did}}-{{member.id}}-fixedmodifier">{{member.label}}</label>
                <input id="dm-{{../did}}-{{member.id}}-fixedmodifier" disabled type="text" value="{{member.value}}" data-dtype="Text"/>
              </div>
            {{/ife}}
            {{#ife member.type "statusDoT"}}
              <div class="m-roll-row">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.value}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
            {{#ife member.type "corruptingattack"}}
              <div class="m-roll-row">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.value}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
            {{/ifn}}
          {{/each}}
        {{/ifgt}}
      {{/ife}}
    {{/each}}
    {{!-- Axtkünstler-Testrunde 1 (Rudolf, 29.10.): Bastardwaffe ist eine
         WAFFENQUALITÄT - der Griff-Radioblock gehört unter die
         Qualitäten-Zeilen, in einem Rahmen mit Qualitäts-Label --}}
    {{#if askBastardGrip}}
      <fieldset class="m-ability-frame">
        <legend class="m-ability-label">{{localize "QUALITY.BASTARD"}}</legend>
        <div class="m-roll-favour">
          <label class="lblfavour">{{radioBoxes "bripType" gripChoices checked=defaultGrip localize=true}}</label>
        </div>
      </fieldset>
    {{/if}}
    {{!-- Fähigkeitsboni (v1.2): von Fähigkeiten/Merkmalen ins Default-Paket
         geschobene Mitglieder (abilityMod-Flag, z. B. Eisenfaust-Adept
         "+1d4") - feste Anzeige-Zeilen VOR den Paket-Radios/Checkboxen --}}
    {{#each weaponModifiers.package as |package|}}
      {{#ife package.type "default"}}
        {{#ifgt package.member.length 0}}
          {{#each package.member as |member|}}
            {{#ife member.abilityMod true}}
            {{#ife member.type "attackrollmod"}}
              <div class="m-roll-row">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.modifier}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
            {{#ife member.type "damagemodifier"}}
              <div class="m-roll-row">
                <label for="dm-{{../did}}-{{member.id}}-fixedmodifier">{{member.label}}</label>
                <input id="dm-{{../did}}-{{member.id}}-fixedmodifier" disabled type="text" value="{{member.value}}" data-dtype="Text"/>
              </div>
            {{/ife}}
            {{#ife member.type "statusDoT"}}
              <div class="m-roll-row">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.value}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
            {{#ife member.type "corruptingattack"}}
              <div class="m-roll-row">
                <label>{{member.label}}</label>
                <input type="text" value="{{member.value}}" data-dtype="Text" disabled/>
              </div>
            {{/ife}}
            {{/ife}}
          {{/each}}
        {{/ifgt}}
      {{/ife}}
    {{/each}}
    {{!-- Fähigkeitsboni: Paket-Radios und Paket-Checkboxen.
         Axtkünstler-Testrunde 1 (Rudolf, 29.10.): Jede Fähigkeit bekommt
         ihren eigenen Rahmen mit dem Fähigkeits-Namen als kleinem Label
         oben - die Radios tragen nur noch den Effekt (radioAlternativesShort),
         der Fähigkeits-Name steht im Rahmen-Label (rückwirkend für
         Eisenfaust und alle künftigen Radio-Pakete) --}}
    {{#each weaponModifiers.package as |package|}}
      {{#ife package.type "radio"}}
        <fieldset class="m-ability-frame">
          <legend class="m-ability-label">{{package.label}}</legend>
          <div class="m-roll-favour"><label class="lblfavour">{{radioBoxes package.id package.radioAlternativesShort checked=package.defaultSelect localize=false}}</label></div>
        </fieldset>
      {{/ife}}
      {{#ife package.type "checkbox"}}
        <div class="m-roll-check freeattack-suppress">
          <label for="pgkid-{{../did}}-{{package.id}}">{{package.label}}</label>
          <input class="checkbox" type="checkbox" id="pgkid-{{../did}}-{{package.id}}" value="{{package.value}}" data-dtype="Text" >
        </div>
      {{/ife}}
    {{/each}}
    {{!-- Axtkünstler v1.1 (Rudolfs Testrunde 1): Technik-Auswahl als
         Radio-Block im Würfeldialog des Waffenangriffs (unter dem
         Fähigkeiten-Block); "Einfach" ist Standard, "Doppelschlag" nur
         ab Adept. Die Zusatzinfos stehen als Hover über den Optionen --}}
    {{#if askAxeArtist}}
      <fieldset class="m-ability-frame">
        <legend class="m-ability-label">{{localize "ABILITY_LABEL.AXE_ARTIST"}}</legend>
        <div class="m-roll-favour">
          {{#each axeArtistChoices as |choice|}}
          <label class="lblfavour" title="{{choice.hint}}"><input type="radio" name="axeArtistTechnique" value="{{choice.value}}" {{#if choice.checked}}checked{{/if}}> {{choice.label}}</label>
          {{/each}}
        </div>
      </fieldset>
    {{/if}}
    {{!-- Dreckiger Kampf v1 (Rudolfs Auswahlrunde 29.10.): Fiese-Schläge-
         Technik als eigener Rahmen, Muster Axtkünstler --}}
    {{#if askCheapshot}}
      <fieldset class="m-ability-frame">
        <legend class="m-ability-label">{{localize "ABILITY_LABEL.CHEAP_SHOT"}}</legend>
        <div class="m-roll-favour">
          {{#each cheapshotChoices as |choice|}}
          <label class="lblfavour" title="{{choice.hint}}"><input type="radio" name="cheapshotTechnique" value="{{choice.value}}" {{#if choice.checked}}checked{{/if}}> {{choice.label}}</label>
          {{/each}}
        </div>
      </fieldset>
    {{/if}}
    {{#if askAttackNb}}
      <div class="m-roll-favour"><label class="lblfavour">{{radioBoxes attNbRadio weaponModifiers.radioAttacks localize=false}}</label></div>
    {{/if}}
    {{#if askPoison}}
      <div class="m-roll-row">
        <label for="poison-{{did}}">{{localize "DIALOG.USE_POISON"}}</label>
        <select id="poison-{{did}}">
          <option value="0">{{localize "DIALOG.NO_POISON"}}</option>
          <option value="1">{{localize "DIALOG.LIGHT_POISON"}}</option>
          <option value="2">{{localize "DIALOG.MEDIUM_POISON"}}</option>
          <option value="3">{{localize "DIALOG.STRONG_POISON"}}</option>
        </select>
      </div>
    {{/if}}
  {{/if}}
  {{#if isArmorRoll}}
    <div class="m-roll-check">
      <label for="advantage-{{did}}">{{localize "DIALOG.DISADVANTAGE"}}</label>
      <input type="checkbox" {{roll_defaults.advantage}} id="advantage-{{did}}" value="1" data-dtype="Number">
    </div>
  {{/if}}

</div>
