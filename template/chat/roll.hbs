<div class='symbaroum chat roll'>
	<div class='foreground'>
		<img class='portrait' src='{{subImg}}' />
		{{!-- v1.5 (Rudolfs Punkt 2, Hungerprobe): optionale Titelzeile
		      („{Name} macht eine Hungerprobe!"), nur gerendert, wenn der
		      Aufrufer introText setzt (roll.js, dialog.js Hunger-Kontext);
		      alle anderen Würfe unverändert. --}}
		{{#if introText}}<h4 class='symb-roll-intro'>{{introText}}</h4>{{/if}}
		<h3>{{removeMarkup name}}</h3>
		{{#if hasSucceed}}

			<div class='dice-roll dice-total' data-action="expandRoll">
				<div>
					<h4>{{resultLevelLabel}} (<span class='symba-rolls roll d20 success'>{{diceResult}}</span>)</h4>
					<h4>{{localize 'CHAT.MARGIN'}} {{margin}} <img class='moreinfo' src='systems/symbaroum/asset/image/orb-direction.svg' /></h4>
				</div>
				<div class='dice-tooltip'>{{{diceBreakdown}}}<br />
					{{localize 'CHAT.ATTRIBUTE_TARGET'}}
					{{diceTarget}}
					-
					<span class='symba-rolls roll d20 success'>{{diceResult}}</span>
					=
					{{margin}}
				</div>
			</div>

			{{#if hasWeapon}}

				<img class='portrait' src='{{weapon.img}}' />
				<p style='margin-top: 5px;text-align:center' data-item-id='{{weapon.id}}'>{{weapon.name}}</p>
				<div class='dice-roll dice-total' data-action="expandRoll">
					<div class='dice-tooltip'>{{{weapon.diceBreakdown}}}</div>
					<div class='baseinfo'><strong>{{localize 'WEAPON.DAMAGE'}}: {{weapon.value}}</strong><img
							class='moreinfo'
							src='systems/symbaroum/asset/image/orb-direction.svg'							
						/></div>
				</div>
			{{/if}}
		{{else}}

			<div class='dice-roll dice-total' data-action="expandRoll">
				<div>
					<h4>{{resultLevelLabel}} (<span class='symba-rolls roll d20 failure'>{{diceResult}}</span>)</h4>
					<h4>{{localize 'CHAT.MARGIN'}} {{margin}} <img class='moreinfo' src='systems/symbaroum/asset/image/orb-direction.svg' /></h4>
				</div>
				<div class='dice-tooltip'>{{{diceBreakdown}}}<br />
					{{localize 'CHAT.ATTRIBUTE_TARGET'}}
					{{diceTarget}}
					-
					<span class='symba-rolls roll d20 failure'>{{diceResult}}</span>
					=
					{{margin}}</div>
			</div>

			{{#if hasArmor}}
				<img class='portrait' src='{{armor.img}}' />
				<p style='margin-top: 5px;text-align:center' data-item-id='{{armor.id}}'>{{armor.name}}</p>
				<div class='dice-roll dice-total' data-action="expandRoll">
					<div class='baseinfo'><strong>{{localize 'ARMOR.PROTECTION'}}:
							{{armor.value}}</strong>
						<img class='moreinfo' src='systems/symbaroum/asset/image/orb-direction.svg' /></div>
					<div class='dice-tooltip'>{{{armor.diceBreakdown}}}</div>
				</div>
			{{/if}}
		{{/if}}

		{{#if hasWeapon}}
			{{#if critFail}}
				<h4>{{localize 'CHAT.CRITICAL_FAILURE_FREEATTACK'}}</h4>
			{{/if}}
		{{/if}}

		{{#if hasArmor}}
			{{#if critSuccess}}
				<h4>{{localize 'CHAT.CRITICAL_FREEATTACK'}}</h4>
			{{/if}}
			{{#if critFail}}
				<h4>{{localize 'CHAT.CRITICAL_PLUS3DAMAGE'}}</h4>
			{{/if}}
		{{/if}}

		{{!-- S3 (/rig-Erweiterung, Rudolfs Freigabe 07.11.2026): Hinweis-
		     zeile bei erzwungenem Würfelergebnis — der Tooltip über der
		     Probe zeigt den ECHTEN Wurf. --}}
		{{#if rigged}}
		<h4>{{localize "RIG.CHAT_LINE" value=rigged}}</h4>
		{{/if}}

	</div>
</div>