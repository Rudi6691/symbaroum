<div class="symbaroum dialog">
    <div class="bonus">
        <label for="modifier-{{did}}">{{localize "DIALOG.MODIFIER"}}</label>
        <input id="modifier-{{did}}" value="{{roll_defaults.modifier}}" type="number" data-dtype="Number"/>
    </div>    
    {{#if deathMod.forced}}
    {{!-- P26-fix1 (Rudolfs Testrunde, P26-02: „Nicht verriegeln. Manuelle
         Einstellung muss möglich sein."): Der Zwangswert aus Zäh/Kränklich
         ist VORAUSWAHL des Radios unten (dialog.js setzt
         roll_defaults.selectedFavour) — das Radio bleibt änderbar. Der
         Segen/Last steht als Hinweiszeile darüber. --}}
    <div class="favour">
        <label class="lblfavour">{{localize deathMod.labelKey}}</label>
    </div>
    {{/if}}
    <div class="favour">
        <label class="lblfavour">{{radioBoxes groupName choices checked=roll_defaults.selectedFavour localize=true}}</label>
    </div>
</div>
